<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material 3 DayNight. -->
    <style name="Base.Theme.Rikua" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_forest</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorPrimaryContainer">@color/primary_forest_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_forest_container</item>

        <item name="colorSecondary">@color/gold_primary</item>
        <item name="colorOnSecondary">@color/text_white</item>
        <item name="colorSecondaryContainer">@color/gold_container</item>
        <item name="colorOnSecondaryContainer">@color/gold_dark</item>

        <item name="android:colorBackground">@color/surface_cream_light</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/primary_forest</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Rikua" parent="Base.Theme.Rikua" />

    <!-- Custom Card Style -->
    <style name="Widget.Rikua.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/surface_card_border</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>

    <!-- Kartu beranda: tanpa bayangan, hanya garis rambut.
         Kartu isi tidak melayang; bayangan disimpan untuk kolom cari. -->
    <style name="Widget.Rikua.FlatCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/surface_card_border</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="rippleColor">@color/primary_forest_container</item>
    </style>

    <!-- Tab aktif memakai hijau hutan agar status navigasi terbaca sebagai
         warna utama, bukan aksen emas. -->
    <style name="Widget.Rikua.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_forest_container</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- Chip filter halaman Layanan: pill, terpilih hijau hutan dengan teks putih. -->
    <style name="Widget.Rikua.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textSize">13sp</item>
        <item name="rippleColor">@color/primary_forest_container</item>
    </style>

    <!-- Top app bar halaman Layanan: judul serif sebagai suara institusi,
         identitas kantor kecil di bawahnya. -->
    <style name="TextAppearance.Rikua.AppBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_forest</item>
    </style>

    <style name="TextAppearance.Rikua.AppBarSubtitle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gold_dark</item>
    </style>

    <!-- Splash: hijau penuh sejak jendela terbuka agar tak ada kedip putih. -->
    <style name="Theme.Rikua.Splash" parent="Theme.Rikua">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/primary_forest_deep</item>
        <item name="android:navigationBarColor">@color/primary_forest_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Kolom isian autentikasi: outline radius kontrol, garis rambut netral. -->
    <style name="Widget.Rikua.AuthField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="boxStrokeColor">@color/auth_field_stroke</item>
        <item name="hintTextColor">@color/primary_forest</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="startIconTint">@color/text_muted</item>
        <item name="boxBackgroundColor">@color/surface_white</item>
    </style>

    <!-- Tombol utama: hijau hutan, teks putih, radius kontrol. -->
    <style name="Widget.Rikua.AuthButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_forest</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="rippleColor">@color/primary_forest_light</item>
    </style>

    <!-- Tombol masuk admin: outlined agar tak bersaing dengan tombol utama. -->
    <style name="Widget.Rikua.AuthButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary_forest</item>
        <item name="strokeColor">@color/surface_card_border</item>
        <item name="iconTint">@color/primary_forest</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="rippleColor">@color/primary_forest_container</item>
    </style>

    <!-- Tombol Masuk dengan Google: latar putih, garis rambut abu, logo asli
         tanpa tint. Selaras radius kontrol dengan tombol lain, warna netral
         agar logo Google tetap jadi penanda utama. -->
    <style name="Widget.Rikua.AuthButton.Google" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface_white</item>
        <item name="strokeColor">@color/google_button_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@null</item>
        <item name="iconPadding">12dp</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="rippleColor">@color/surface_cream</item>
    </style>
</resources>