<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== Facility Detail — Info Row ==================== -->
    <!-- Baris informasi: ikon + label + nilai -->
    <style name="DetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="DetailRowIconFrame">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_rounded_green</item>
    </style>

    <style name="DetailRowIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:tint">@color/consult_primary</item>
    </style>

    <style name="DetailRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DetailRowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="DetailRowValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DetailRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">54dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- ==================== Rekomendasi Nikah — Checklist Berkas ==================== -->
    <!-- Baris checklist: ikon centang + judul + deskripsi (min. touch 48dp) -->
    <style name="RekomChecklistRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="RekomChecklistIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">@drawable/bg_rekom_icon_teal_soft</item>
        <item name="android:tint">@color/status_green</item>
    </style>

    <style name="RekomChecklistText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="RekomChecklistTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="RekomChecklistDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ==================== Rekomendasi Nikah — Timeline Langkah ==================== -->
    <style name="RekomStepNumber">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_rekom_step_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/md3_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="RekomStepCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="strokeColor">@color/md3_outline_variant_40</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="RekomStepCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="RekomStepTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RekomStepDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ==================== Isbat Nikah — Kartu Poin "Kapan Diperlukan" ==================== -->
    <style name="IsbatKapanCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/md3_card_outlined</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="IsbatKapanIcon">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_rekom_icon_teal_soft</item>
        <item name="android:tint">@color/md3_primary</item>
    </style>

    <style name="IsbatKapanText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="IsbatKapanTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="IsbatKapanDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Badge status berkas (WAJIB / FOTOKOPI) di kanan row checklist -->
    <style name="IsbatBerkasBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">9sp</item>
    </style>

    <!-- Angka berkas 1-3 (lingkar teal kecil) khusus halaman Wakaf -->
    <style name="WakafBerkasNumber">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_rekom_step_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/md3_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ==================== Wali Nikah — Tertib Wali Nasab ==================== -->
    <!-- Angka urutan wali 2-7 (lingkar teal kecil) -->
    <style name="WaliNasabNumber">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_rekom_step_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/md3_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Angka wali-1 (Ayah) serasi kartu emas: lingkar transparan tepi emas -->
    <style name="WaliNasabNumberGold">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_isbat_step_circle_gold</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/md3_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Pemisah halus antar poin wali nasab -->
    <style name="WaliNasabDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">44dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Row kondisi wali hakim: dot teal + judul & penjelasan -->
    <style name="WaliHakimKondisiRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">top|start</item>
    </style>

    <style name="WaliHakimKondisiDot">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/bg_badge_teal</item>
    </style>

    <!-- ==================== Taukil Wali bil Kitabah — Grid 2x2 ==================== -->
    <!-- Kartu kondisi pada grid "Kapan Diperlukan?" -->
    <style name="TaukilGridCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/md3_card_outlined</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="TaukilGridIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/bg_rekom_icon_teal_soft</item>
        <item name="android:tint">@color/md3_primary</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="TaukilGridTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TaukilGridDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
