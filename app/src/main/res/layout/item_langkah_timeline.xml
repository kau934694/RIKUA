<?xml version="1.0" encoding="utf-8"?>
<!--
    Node timeline alur pendaftaran (tabel langkah_layanan).
    Kolom kiri: dot bernomor + garis penghubung emas; kolom kanan: teks
    langkah langsung (tanpa kartu bersarang, hemat elevasi & radius).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="18dp">

    <!-- Kolom dot + garis -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_timeline_dot">

            <TextView
                android:id="@+id/tv_nomor_langkah"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                tools:text="1" />
        </FrameLayout>

        <!-- Garis penghubung emas; disembunyikan pada langkah terakhir oleh Activity -->
        <View
            android:id="@+id/view_timeline_line"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_syarat_gold_rule" />
    </LinearLayout>

    <!-- Isi langkah -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_judul_langkah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Siapkan dan legalisasi berkas N1-N4" />

        <TextView
            android:id="@+id/tv_deskripsi_langkah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Ambil surat pengantar dari desa dan lengkapi fotokopi KTP." />

        <!-- Meta: lokasi & estimasi waktu -->
        <LinearLayout
            android:id="@+id/layout_meta_langkah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_lokasi_langkah"
                style="@style/SyaratCaption"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:drawableStartCompat="@drawable/ic_location"
                app:drawableTint="@color/text_muted"
                tools:text="Loket 1 KUA" />

            <TextView
                android:id="@+id/tv_estimasi_langkah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:drawablePadding="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/syarat_primary"
                android:textSize="11sp"
                app:drawableStartCompat="@drawable/ic_schedule"
                app:drawableTint="@color/syarat_primary"
                tools:text="15 menit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
