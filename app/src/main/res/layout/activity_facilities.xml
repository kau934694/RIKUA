<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".FacilitiesActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/facilities_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_cream_light">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="92dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header hijau identitas RIKUA: logo, nama, KUA Randudongkal, drawer, pola islami. -->
                <FrameLayout
                    android:id="@+id/banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_curved">

                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-30dp"
                        android:layout_marginEnd="-40dp"
                        android:alpha="0.85"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bg_islamic_pattern" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/page_gutter"
                        android:paddingTop="24dp"
                        android:paddingEnd="@dimen/page_gutter"
                        android:paddingBottom="26dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_app_logo"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:contentDescription="Logo KUA"
                                    android:src="@drawable/logo" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:letterSpacing="0.05"
                                        android:text="RIKUA"
                                        android:textColor="@color/text_white"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="KUA Kec.\nRandudongkal"
                                        android:textColor="@color/gold_accent"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btn_menu_drawer"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Menu Navigasi"
                                android:focusable="true"
                                android:padding="8dp"
                                android:src="@drawable/ic_menu"
                                app:tint="@color/text_white" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="serif"
                            android:letterSpacing="0.02"
                            android:text="@string/facilities_section_title"
                            android:textColor="@color/text_white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/facilities_section_desc"
                            android:textColor="@color/text_white_80"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Pencarian nyata lewat TextWatcher; tombol hapus muncul saat ada teks. -->
                <LinearLayout
                    android:id="@+id/search_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:background="@drawable/bg_search_field"
                    android:elevation="1dp"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/primary_forest" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/facilities_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btn_clear_search"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/facilities_search_clear"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/text_muted"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Filter kategori: satu-satu, chip bergaya identitas RIKUA. -->
                <HorizontalScrollView
                    android:id="@+id/chip_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/page_gutter"
                    android:paddingEnd="@dimen/page_gutter"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_filters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_all"
                            style="@style/Widget.Rikua.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/facilities_filter_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_masjid"
                            style="@style/Widget.Rikua.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/facilities_filter_masjid" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_musholla"
                            style="@style/Widget.Rikua.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/facilities_filter_musholla" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_pesantren"
                            style="@style/Widget.Rikua.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/facilities_filter_pesantren" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_tpq"
                            style="@style/Widget.Rikua.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/facilities_filter_tpq" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_madin"
                            style="@style/Widget.Rikua.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/facilities_filter_madin" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Filter desa: sumber data R.array.facilities_villages. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/facilities_village_label"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_search_field"
                        android:minHeight="@dimen/touch_target">

                        <Spinner
                            android:id="@+id/spinner_village"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_result_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="5 sarana ditemukan" />

                <!-- Daftar bersumber dari API, tinggi mengikuti jumlah data. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_facilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="4dp"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_facility" />

                <!-- Empty state: tampil saat hasil filter kosong. -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_icon_rounded_green">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/primary_forest" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/facilities_empty_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/facilities_empty_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Konsultasi pendataan sarana via WhatsApp. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/surface_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_rounded_green">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_whatsapp"
                                    app:tint="@color/primary_forest" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/facilities_help_title"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/facilities_help_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_konsultasi_pendataan"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target"
                            android:layout_marginTop="14dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/facilities_help_btn"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            app:backgroundTint="@color/primary_forest"
                            app:cornerRadius="@dimen/radius_control"
                            app:icon="@drawable/ic_whatsapp"
                            app:iconGravity="start"
                            app:iconSize="18dp"
                            app:iconTint="@color/text_white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/surface_white"
            android:minHeight="64dp"
            app:elevation="4dp"
            app:itemActiveIndicatorStyle="@style/Widget.Rikua.BottomNav.ActiveIndicator"
            app:itemIconTint="@color/bottom_nav_color_selector"
            app:itemRippleColor="@color/primary_forest_container"
            app:itemTextColor="@color/bottom_nav_color_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Drawer sekunder; destinasi nyata via handleNavigation(). -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
