<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".FacilitiesActivity">

    <!-- =================== MAIN CONTENT =================== -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/facilities_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_cream_light">

        <!-- =================== APP BAR =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_forest"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/primary_forest"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/text_white"
                app:subtitle="@string/facilities_toolbar_subtitle"
                app:subtitleTextColor="@color/gold_accent"
                app:title="@string/facilities_toolbar_title"
                app:titleTextColor="@color/text_white" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="92dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- === 1. HEADER BANNER + BADGE + DESCRIPTION === -->
                <FrameLayout
                    android:id="@+id/banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_curved">

                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-30dp"
                        android:layout_marginEnd="-40dp"
                        android:alpha="0.85"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bg_islamic_pattern" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="24dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="26dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="serif"
                            android:letterSpacing="0.02"
                            android:text="@string/facilities_section_title"
                            android:textColor="@color/text_white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/facilities_section_desc"
                            android:textColor="@color/text_white_80"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- === 2. SEARCH INPUT === -->
                <LinearLayout
                    android:id="@+id/search_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_search_field"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/primary_forest" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/facilities_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btn_clear_search"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/facilities_search_clear"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/text_tertiary"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- === 3. CATEGORY FILTER CHIPS (horizontal carousel) === -->
                <HorizontalScrollView
                    android:id="@+id/chip_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_filters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_all"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:minHeight="48dp"
                            android:text="@string/facilities_filter_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_masjid"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/facilities_filter_masjid" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_musholla"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/facilities_filter_musholla" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_pesantren"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/facilities_filter_pesantren" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_tpq"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/facilities_filter_tpq" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_madin"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/facilities_filter_madin" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- === 4. VILLAGE SPINNER === -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/facilities_village_label"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_search_field"
                        android:elevation="1dp">

                        <Spinner
                            android:id="@+id/spinner_village"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- === 5. RESULT COUNT === -->
                <TextView
                    android:id="@+id/tv_result_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="20dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    tools:text="5 sarana ditemukan" />

                <!-- Facility RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_facilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="18dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="4dp"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_facility" />

                <!-- === 5b. EMPTY STATE (hidden by default) === -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_icon_rounded_blue">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/badge_blue_text" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/facilities_empty_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/facilities_empty_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- === 6. HELP / CTA CARD === -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="18dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#B7E4CD"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_help_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_rounded_green">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_chat"
                                    app:tint="@color/primary_forest" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/facilities_help_title"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/facilities_help_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_konsultasi_pendataan"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/facilities_help_btn"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            app:backgroundTint="@color/primary_forest"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_chat"
                            app:iconGravity="start"
                            app:iconSize="18dp"
                            app:iconTint="@color/text_white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- === 8. BOTTOM NAVIGATION BAR === -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_gravity="bottom"
            android:background="@color/surface_white"
            app:elevation="10dp"
            app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
            app:itemIconTint="@color/bottom_nav_color_selector"
            app:itemRippleColor="@color/primary_forest_container"
            app:itemTextColor="@color/bottom_nav_color_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- === NAVIGATION DRAWER (end gravity) === -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
