<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_blanko_item"
    style="@style/Widget.Rikua.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Kode dokumen N1–N6: penanda cepat, kotak hijau solid. -->
        <TextView
            android:id="@+id/tv_blanko_kode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_blanko_kode"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="N1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_blanko_judul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Surat Keterangan Belum Pernah Nikah" />

            <TextView
                android:id="@+id/tv_blanko_deskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Formulir pernyataan belum pernah menikah, bermaterai" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_blanko_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    tools:text="PDF • 120 KB" />

                <TextView
                    android:id="@+id/tv_blanko_kategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_badge_emerald"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/badge_emerald_text"
                    android:textSize="11sp"
                    tools:text="Wajib" />
            </LinearLayout>

            <!-- Aksi unduh: satu-satunya elemen interaktif pada kartu. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_unduh_pdf"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="140dp"
                android:text="@string/blanko_btn_unduh"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                app:backgroundTint="@color/primary_forest"
                app:cornerRadius="@dimen/radius_control"
                app:icon="@drawable/ic_download"
                app:iconGravity="start"
                app:iconSize="16dp"
                app:iconTint="@color/text_white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
