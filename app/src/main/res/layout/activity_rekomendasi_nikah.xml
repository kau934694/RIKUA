<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".RekomendasiNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/rekom_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_cream_light">

        <!-- Toolbar hijau identitas, menyatu dengan band hero di bawahnya. -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/rekom_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary"
                app:subtitle="@string/syarat_toolbar_subtitle"
                app:subtitleTextColor="@color/gold_accent"
                app:title="@string/rekom_toolbar_title"
                app:titleTextColor="@color/md3_on_primary" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="180dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <!-- Hero: latar krem menyatu halaman, teks gelap. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-18dp"
                    android:layout_marginEnd="-18dp"
                    android:background="@color/surface_cream_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="@string/rekom_hero_title"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/rekom_hero_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Section "Kapan Diperlukan?": narasi langsung di atas krem. -->
                <TextView
                    style="@style/RekomSectionTitle"
                    android:layout_marginTop="28dp"
                    android:text="@string/rekom_kapan_title" />

                <View style="@style/RekomSectionRule" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/rekom_kapan_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rekom_notice_teal"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/badge_teal_text" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/rekom_kapan_info"
                        android:textColor="@color/badge_teal_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Section "Yang Perlu Disiapkan": 4 berkas, ikon per dokumen. -->
                <TextView
                    style="@style/RekomSectionTitle"
                    android:layout_marginTop="32dp"
                    android:text="@string/rekom_siap_title" />

                <View style="@style/RekomSectionRule" />

                <TextView
                    style="@style/RekomSectionSubtitle"
                    android:text="@string/rekom_siap_subtitle" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rekom_card_edge"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="2dp">

                        <LinearLayout style="@style/RekomDocRow">

                            <ImageView
                                style="@style/RekomDocIcon"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_description" />

                            <LinearLayout style="@style/RekomDocText">

                                <TextView
                                    style="@style/RekomDocTitle"
                                    android:text="@string/rekom_berkas_1_title" />

                                <TextView
                                    style="@style/RekomDocDesc"
                                    android:text="@string/rekom_berkas_1_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="52dp"
                            android:background="@color/divider" />

                        <LinearLayout style="@style/RekomDocRow">

                            <ImageView
                                style="@style/RekomDocIcon"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_badge" />

                            <LinearLayout style="@style/RekomDocText">

                                <TextView
                                    style="@style/RekomDocTitle"
                                    android:text="@string/rekom_berkas_2_title" />

                                <TextView
                                    style="@style/RekomDocDesc"
                                    android:text="@string/rekom_berkas_2_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="52dp"
                            android:background="@color/divider" />

                        <LinearLayout style="@style/RekomDocRow">

                            <ImageView
                                style="@style/RekomDocIcon"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_camera" />

                            <LinearLayout style="@style/RekomDocText">

                                <TextView
                                    style="@style/RekomDocTitle"
                                    android:text="@string/rekom_berkas_3_title" />

                                <TextView
                                    style="@style/RekomDocDesc"
                                    android:text="@string/rekom_berkas_3_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="52dp"
                            android:background="@color/divider" />

                        <LinearLayout style="@style/RekomDocRow">

                            <ImageView
                                style="@style/RekomDocIcon"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_person" />

                            <LinearLayout style="@style/RekomDocText">

                                <TextView
                                    style="@style/RekomDocTitle"
                                    android:text="@string/rekom_berkas_4_title" />

                                <TextView
                                    style="@style/RekomDocDesc"
                                    android:text="@string/rekom_berkas_4_desc" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section "Alur": rel hijau menyambung, teks tanpa kartu. -->
                <TextView
                    style="@style/RekomSectionTitle"
                    android:layout_marginTop="32dp"
                    android:text="@string/rekom_langkah_title" />

                <View style="@style/RekomSectionRule" />

                <TextView
                    style="@style/RekomSectionSubtitle"
                    android:text="@string/rekom_langkah_subtitle" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/tv_step_1"
                        style="@style/RekomAlurNumber"
                        android:text="@string/rekom_step_1_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/rekom_rail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_1"
                        app:layout_constraintStart_toStartOf="@id/tv_step_1"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        android:paddingBottom="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_1"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/RekomAlurTitle"
                            android:text="@string/rekom_langkah_1_title" />

                        <TextView
                            style="@style/RekomAlurDesc"
                            android:text="@string/rekom_langkah_1_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_step_2"
                        style="@style/RekomAlurNumber"
                        android:text="@string/rekom_step_2_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/rekom_rail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_2"
                        app:layout_constraintStart_toStartOf="@id/tv_step_2"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        android:paddingBottom="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_2"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/RekomAlurTitle"
                            android:text="@string/rekom_langkah_2_title" />

                        <TextView
                            style="@style/RekomAlurDesc"
                            android:text="@string/rekom_langkah_2_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_step_3"
                        style="@style/RekomAlurNumber"
                        android:text="@string/rekom_step_3_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_3"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/RekomAlurTitle"
                            android:text="@string/rekom_langkah_3_title" />

                        <TextView
                            style="@style/RekomAlurDesc"
                            android:text="@string/rekom_langkah_3_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Panel sticky: aksi utama lalu navigasi. -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/surface_white"
            android:elevation="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_unduh_blanko"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/rekom_btn_unduh_blanko"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@color/md3_primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_on_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_konsultasi"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/rekom_btn_konsultasi"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_primary"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_chat"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_primary"
                        app:strokeColor="@color/md3_primary"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
