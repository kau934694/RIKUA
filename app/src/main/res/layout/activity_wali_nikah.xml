<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_wali_nikah.xml
     Halaman "Wali Nikah" (tertib wali nasab & wali hakim) MD3
     Palette: primary #005145 / #0f6b5c, container #a2f2de, secondary #795902 /
              #fdd275, surface #f7f9ff, card #ffffff, border #bec9c5 @ 40%.
    ============================================================================
     Struktur:
       DrawerLayout
         └─ CoordinatorLayout
              ├─ AppBarLayout + MaterialToolbar   (back | judul tengah | burger)
              ├─ NestedScrollView (paddingBottom 220dp — bebas dock)
              │    ├─ Kartu headline  : badge resmi + diperbarui + judul/deskripsi
              │    ├─ Wali Nasab 1–7  : poin-1 kartu emas "PRIORITAS UTAMA",
              │    │                    lalu kartu putih row 2–7 berdivider
              │    ├─ Accordion        : "Kapan Memakai Wali Hakim?" (gavel +
              │    │                    chevron, body 4 kondisi + catatan biru)
              │    └─ Notice alert     : pesan konsultasi silsilah (amber)
              └─ layout_bottom_sticky  (dock aksi + teks bantuan + bottom nav)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".WaliNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/wali_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <!-- Judul tengah + subjudul KUA (custom center view) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wali_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wali_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="220dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp">

                <!-- ==== 1. OFFICIAL BADGE & METADATA + HEADLINE SUMMARY ==== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Badge resmi + tanggal pembaruan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rekom_badge_official"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_verified"
                                app:tint="@color/badge_emerald_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/wali_badge_resmi"
                                android:textColor="@color/badge_emerald_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:drawablePadding="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="@string/wali_diperbarui"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"
                            app:drawableEndCompat="@drawable/ic_schedule"
                            app:drawableTint="@color/text_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wali_headline_title"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/wali_headline_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ==== 2. URUTAN WALI NASAB (PRIORITAS 1–7) ==== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:text="@string/wali_urutan_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_how_to_reg"
                    app:drawableTint="@color/md3_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/wali_urutan_intro"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <!-- Poin 1 — Ayah kandung: aksen emas + badge Prioritas Utama -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/md3_secondary_container"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/syarat_accent_gold"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp">

                        <TextView
                            style="@style/WaliNasabNumberGold"
                            android:text="@string/rekom_step_1_number" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/wali_nasab_1_title"
                                android:textColor="@color/md3_secondary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/wali_nasab_1_desc"
                                android:textColor="@color/md3_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_syarat_badge_resmi"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.04"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="@string/wali_badge_prioritas"
                            android:textColor="@color/md3_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Poin 2–7 — kartu putih berdivider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <!-- Poin 2 — Kakek -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="@string/rekom_step_2_number" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wali_nasab_2_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wali_nasab_2_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/WaliNasabDivider" />

                    <!-- Poin 3 — Saudara laki-laki kandung -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="@string/rekom_step_3_number" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wali_nasab_3_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wali_nasab_3_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/WaliNasabDivider" />

                    <!-- Poin 4 — Saudara laki-laki seayah -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="4" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wali_nasab_4_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wali_nasab_4_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/WaliNasabDivider" />

                    <!-- Poin 5 — Paman kandung -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="5" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wali_nasab_5_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wali_nasab_5_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/WaliNasabDivider" />

                    <!-- Poin 6 — Paman seayah -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="6" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wali_nasab_6_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wali_nasab_6_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/WaliNasabDivider" />

                    <!-- Poin 7 — Anak laki-laki dari paman (sepupu jalur ayah) -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="7" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wali_nasab_7_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wali_nasab_7_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ==== 3. ACCORDION "KAPAN MEMAKAI WALI HAKIM?" ==== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hakim_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/md3_surface_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md3_outline_variant_40"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header accordion (klik = expand/collapse dari Activity) -->
                        <LinearLayout
                            android:id="@+id/hakim_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_rekom_icon_teal_soft"
                                android:contentDescription="@null"
                                android:padding="9dp"
                                android:src="@drawable/ic_gavel"
                                app:tint="@color/md3_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/wali_hakim_question"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_hakim_chevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/text_tertiary" />
                        </LinearLayout>

                        <!-- Body accordion (awal collapsed, animasi dari Activity) -->
                        <LinearLayout
                            android:id="@+id/hakim_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/wali_hakim_intro"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <!-- Kondisi 1 — Putus Nasab -->
                            <LinearLayout style="@style/WaliHakimKondisiRow">

                                <View style="@style/WaliHakimKondisiDot" />

                                <LinearLayout style="@style/RekomChecklistText">

                                    <TextView
                                        style="@style/RekomChecklistTitle"
                                        android:text="@string/wali_hakim_c1_title" />

                                    <TextView
                                        style="@style/RekomChecklistDesc"
                                        android:text="@string/wali_hakim_c1_desc" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Kondisi 2 — Wali Mafqud -->
                            <LinearLayout style="@style/WaliHakimKondisiRow">

                                <View style="@style/WaliHakimKondisiDot" />

                                <LinearLayout style="@style/RekomChecklistText">

                                    <TextView
                                        style="@style/RekomChecklistTitle"
                                        android:text="@string/wali_hakim_c2_title" />

                                    <TextView
                                        style="@style/RekomChecklistDesc"
                                        android:text="@string/wali_hakim_c2_desc" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Kondisi 3 — Wali Berhalangan Jauh -->
                            <LinearLayout style="@style/WaliHakimKondisiRow">

                                <View style="@style/WaliHakimKondisiDot" />

                                <LinearLayout style="@style/RekomChecklistText">

                                    <TextView
                                        style="@style/RekomChecklistTitle"
                                        android:text="@string/wali_hakim_c3_title" />

                                    <TextView
                                        style="@style/RekomChecklistDesc"
                                        android:text="@string/wali_hakim_c3_desc" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Kondisi 4 — Wali Adhal -->
                            <LinearLayout style="@style/WaliHakimKondisiRow">

                                <View style="@style/WaliHakimKondisiDot" />

                                <LinearLayout style="@style/RekomChecklistText">

                                    <TextView
                                        style="@style/RekomChecklistTitle"
                                        android:text="@string/wali_hakim_c4_title" />

                                    <TextView
                                        style="@style/RekomChecklistDesc"
                                        android:text="@string/wali_hakim_c4_desc" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Catatan pengangkatan wali hakim -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_rekom_info_blue"
                                android:drawablePadding="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:lineSpacingExtra="2dp"
                                android:paddingStart="12dp"
                                android:paddingTop="10dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="10dp"
                                android:text="@string/wali_hakim_note"
                                android:textColor="@color/md3_info_blue_text"
                                android:textSize="12sp"
                                app:drawableStartCompat="@drawable/ic_info"
                                app:drawableTint="@color/md3_info_blue_text" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ==== 4. INFO NOTICE ALERT CARD ==== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_notice_amber"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_campaign"
                        app:tint="@color/badge_amber_text" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/wali_notice_text"
                        android:textColor="@color/badge_amber_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STICKY BOTTOM: DOCK AKSI + BOTTOM NAV ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/md3_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <!-- Contextual action tray -->
            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_syarat_nikah"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wali_btn_syarat"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_primary"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_description"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_primary"
                        app:strokeColor="@color/md3_primary"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_konsultasi"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wali_btn_konsultasi"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@color/md3_primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_chat"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_on_primary" />
                </LinearLayout>

                <!-- Tautan bantuan petugas -> WhatsApp resmi -->
                <TextView
                    android:id="@+id/tv_bantuan_petugas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/wali_bantuan_petugas"
                    android:textColor="@color/md3_primary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_help_center"
                    app:drawableTint="@color/md3_primary" />
            </LinearLayout>

            <!-- Bottom Navigation Persistent (5 tab, Layanan aktif) -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
