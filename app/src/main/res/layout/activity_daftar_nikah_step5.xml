<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_daftar_nikah_step5.xml
     Alur "Daftar Nikah" Langkah 5 dari 6 — Inkuri & Unggah Dokumen.
     Scaffold MD3: TopAppBar sticky (judul "Unggah Dokumen" + kembali + menu
     drawer), kartu stepper 5/6 (83%) + Simpan Draf, kartu ringkasan
     kelengkapan (8 dari 14 dokumen / 57% + unduh blanko N1–N6), dua grup
     RecyclerView dokumen (Utama & Tambahan), kartu ketentuan berkas, lalu
     dock sticky "Lanjut ke Tinjau & Kirim" + tautan bantuan petugas +
     bottom nav (tab Daftar Nikah aktif) dan drawer 12 menu.
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".DaftarNikahStep5Activity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/step5_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/s5_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/daf_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="170dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp">

                <!-- ============ 1. KARTU STEPPER & DRAF (5/6 — 83%) ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/md3_surface_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md3_outline_variant_40"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/s5_stepper_label"
                                android:textColor="@color/md3_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_simpan_draf"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/s2_btn_simpan_draf"
                                android:textAllCaps="false"
                                android:textColor="@color/md3_primary"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_save"
                                app:iconGravity="start"
                                app:iconSize="16dp"
                                app:iconTint="@color/md3_primary" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_langkah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:contentDescription="@string/s5_stepper_content_desc"
                            android:max="6"
                            android:progress="5"
                            app:indicatorColor="@color/md3_primary"
                            app:trackColor="@color/syarat_primary_soft"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 2. KARTU RINGKASAN STATUS KELENGKAPAN ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/md3_surface_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md3_outline_variant_40"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_rekom_icon_teal_soft"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_how_to_reg"
                                app:tint="@color/md3_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/s5_summary_title"
                                android:textColor="@color/md3_on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/s5_summary_subtitle"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Baris counter dinamis: "8 dari 14 Dokumen" + "57%" -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_jumlah_dokumen"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/md3_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="8 dari 14 Dokumen" />

                            <TextView
                                android:id="@+id/tv_persen_dokumen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/md3_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="57%" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_dokumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/s5_summary_content_desc"
                            android:max="14"
                            android:progress="8"
                            app:indicatorColor="@color/md3_primary"
                            app:trackColor="@color/md3_surface_container_high"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <!-- Tautan unduh blanko N1–N6 (dibuka dari daftar blanko) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_unduh_blanko"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/s5_btn_unduh_blanko"
                            android:textAllCaps="false"
                            android:textColor="@color/md3_primary"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="start"
                            app:iconSize="18dp"
                            app:iconTint="@color/md3_primary"
                            app:strokeColor="@color/md3_outline_variant_40" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 3. SEKSI 1 — DOKUMEN UTAMA (10 WAJIB) ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/s5_section_utama"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/s5_section_utama_desc"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_dokumen_utama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_upload_dokumen" />

                <!-- ============ 4. SEKSI 2 — DOKUMEN TAMBAHAN ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/s5_section_tambahan"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/s5_section_tambahan_desc"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_dokumen_tambahan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_upload_dokumen" />

                <!-- ============ 5. KARTU INFO — KETENTUAN BERKAS RIKUA ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/md3_surface_container_low"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md3_outline_variant_40"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_info"
                                app:tint="@color/md3_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/s5_info_title"
                                android:textColor="@color/md3_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/s5_info_desc"
                            android:textColor="@color/md3_on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STICKY BOTTOM: AKSI + BOTTOM NAV ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/md3_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lanjut_tinjau"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/s5_btn_lanjut"
                    android:textAllCaps="false"
                    android:textColor="@color/md3_on_primary"
                    android:textSize="15sp"
                    app:backgroundTint="@color/md3_primary_container"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="end"
                    app:iconSize="18dp"
                    app:iconTint="@color/md3_on_primary" />

                <TextView
                    android:id="@+id/tv_bantuan_petugas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:padding="4dp"
                    android:text="@string/s5_bantuan_petugas"
                    android:textColor="@color/md3_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER (12 MENU) =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:menu="@menu/daftar_nikah_drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
