<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_duplikat_buku_nikah.xml
     Halaman "Duplikat Buku Nikah" (penggantian buku nikah hilang/rusak).
     Karakter: register netral — kanvas abu (#F4F5F3), permukaan putih, judul
     charcoal (#22262B), teks deskripsi abu medium, aksen champagne terbatas.
     Sengaja TIDAK memakai format hijau Isbat/Rekomendasi pada area konten.
     Toolbar, sticky dock, bottom nav, drawer tetap memakai identitas hijau KUA.
    ============================================================================
     Struktur:
       DrawerLayout
         └─ CoordinatorLayout (bg dup_bg)
              ├─ AppBarLayout + MaterialToolbar   (back | judul tengah | burger)
              ├─ NestedScrollView (paddingBottom 220dp — bebas dock)
              │    ├─ Kartu intro : judul + garis champagne + deskripsi
              │    ├─ Persyaratan : judul + badge jumlah + 4 row interaktif
              │    │                 (ikon jenis dokumen + teks + badge + centang)
              │    ├─ Timeline    : 4 langkah card-less, rel solid, langkah-4 champagne
              │    └─ Jam layanan : kartu putih + tombol Hubungi (WhatsApp)
              └─ layout_bottom_sticky     (dock aksi + bottom nav 5 tab)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".DuplikatBukuNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/dup_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dup_bg">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <!-- Judul tengah + subjudul KUA (custom center view) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dup_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dup_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="220dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp">

                <!-- ============ 1. INTRO ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dup_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dup_hero_title"
                        android:textColor="@color/dup_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View style="@style/DupSectionRule" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/dup_hero_desc"
                        android:textColor="@color/dup_desc"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- ============ 2. PERSYARATAN DOKUMEN (DAFTAR STATIS 4 ITEM) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dup_siap_title"
                        android:textColor="@color/dup_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Badge jumlah dokumen -->
                    <TextView
                        style="@style/DupBadge"
                        android:layout_marginStart="0dp"
                        android:background="@drawable/bg_dup_badge_champagne"
                        android:text="@string/dup_siap_badge"
                        android:textColor="@color/dup_champagne_text" />
                </LinearLayout>

                <TextView
                    style="@style/DupSectionSubtitle"
                    android:text="@string/dup_siap_subtitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dup_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Dokumen 1 — Surat kehilangan dari Polsek -->
                    <LinearLayout style="@style/DupInfoRow">

                        <ImageView
                            style="@style/DupCheckIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_police_badge" />

                        <LinearLayout style="@style/DupCheckText">

                            <TextView
                                style="@style/DupCheckTitle"
                                android:text="@string/dup_dok_1_title" />

                            <TextView
                                style="@style/DupCheckDesc"
                                android:text="@string/dup_dok_1_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        style="@style/DupHairline"
                        android:layout_marginStart="52dp" />

                    <!-- Dokumen 2 — KTP & KK -->
                    <LinearLayout style="@style/DupInfoRow">

                        <ImageView
                            style="@style/DupCheckIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person" />

                        <LinearLayout style="@style/DupCheckText">

                            <TextView
                                style="@style/DupCheckTitle"
                                android:text="@string/dup_dok_2_title" />

                            <TextView
                                style="@style/DupCheckDesc"
                                android:text="@string/dup_dok_2_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        style="@style/DupHairline"
                        android:layout_marginStart="52dp" />

                    <!-- Dokumen 3 — Buku nikah rusak -->
                    <LinearLayout style="@style/DupInfoRow">

                        <ImageView
                            style="@style/DupCheckIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_description" />

                        <LinearLayout style="@style/DupCheckText">

                            <TextView
                                style="@style/DupCheckTitle"
                                android:text="@string/dup_dok_3_title" />

                            <TextView
                                style="@style/DupCheckDesc"
                                android:text="@string/dup_dok_3_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        style="@style/DupHairline"
                        android:layout_marginStart="52dp" />

                    <!-- Dokumen 4 — Pas foto 2x3 suami istri latar biru -->
                    <LinearLayout style="@style/DupInfoRow">

                        <ImageView
                            style="@style/DupCheckIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_camera" />

                        <LinearLayout style="@style/DupCheckText">

                            <TextView
                                style="@style/DupCheckTitle"
                                android:text="@string/dup_dok_4_title" />

                            <TextView
                                style="@style/DupCheckDesc"
                                android:text="@string/dup_dok_4_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 3. LANGKAH PENGURUSAN (TIMELINE 4 TAHAPAN) ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dup_alur_title"
                    android:textColor="@color/dup_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DupSectionSubtitle"
                    android:text="@string/dup_alur_subtitle" />

                <!-- Langkah 1 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tv_step_1"
                        style="@style/DupStepNumber"
                        android:text="@string/dup_step_1_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/dup_rail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_1"
                        app:layout_constraintStart_toStartOf="@id/tv_step_1"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        android:paddingBottom="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_1"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/DupStepTitle"
                            android:text="@string/dup_alur_1_title" />

                        <TextView
                            style="@style/DupStepDesc"
                            android:text="@string/dup_alur_1_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 2 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tv_step_2"
                        style="@style/DupStepNumber"
                        android:text="@string/dup_step_2_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/dup_rail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_2"
                        app:layout_constraintStart_toStartOf="@id/tv_step_2"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        android:paddingBottom="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_2"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/DupStepTitle"
                            android:text="@string/dup_alur_2_title" />

                        <TextView
                            style="@style/DupStepDesc"
                            android:text="@string/dup_alur_2_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 3 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tv_step_3"
                        style="@style/DupStepNumber"
                        android:text="@string/dup_step_3_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/dup_rail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_3"
                        app:layout_constraintStart_toStartOf="@id/tv_step_3"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_3" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        android:paddingBottom="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_3"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/DupStepTitle"
                            android:text="@string/dup_alur_3_title" />

                        <TextView
                            style="@style/DupStepDesc"
                            android:text="@string/dup_alur_3_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 4 — penanda penyelesaian (aksen champagne) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tv_step_4"
                        style="@style/DupStepNumberGold"
                        android:text="@string/dup_step_4_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_4"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/DupStepTitle"
                            android:text="@string/dup_alur_4_title" />

                        <TextView
                            style="@style/DupStepDesc"
                            android:text="@string/dup_alur_4_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ============ 4. JAM LAYANAN + HUBUNGI ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_dup_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        style="@style/DupCheckIcon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_schedule" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/dup_jam_title"
                            android:textColor="@color/dup_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/hours_weekday"
                            android:textColor="@color/dup_desc"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/hours_friday"
                            android:textColor="@color/dup_desc"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/hours_weekend"
                            android:textColor="@color/dup_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Aksi cepat: Hubungi petugas (WhatsApp admin) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_hubungi"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="96dp"
                        android:text="@string/dup_btn_hubungi"
                        android:textAllCaps="false"
                        android:textColor="@color/surface_white"
                        android:textSize="13sp"
                        app:backgroundTint="@color/dup_charcoal"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_phone"
                        app:iconGravity="start"
                        app:iconSize="16dp"
                        app:iconTint="@color/surface_white" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STICKY BOTTOM: DOCK AKSI + BOTTOM NAV ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/md3_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <!-- Dock tombol aksi layanan -->
            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_konsultasi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dup_btn_konsultasi"
                    android:textAllCaps="false"
                    android:textColor="@color/md3_on_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/md3_primary"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_chat"
                    app:iconGravity="start"
                    app:iconSize="18dp"
                    app:iconTint="@color/md3_on_primary" />
            </LinearLayout>

            <!-- Bottom Navigation Persistent (5 tab, Layanan aktif) -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
