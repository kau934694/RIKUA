<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_wakaf.xml
     Halaman "Wakaf & Kemasjidan" (ikrar wakaf via PPAIW) MD3
     Palette: primary #005145 / #0f6b5c, container #a2f2de, secondary #795902 /
              #fdd275, surface #f7f9ff, card #ffffff, border #bec9c5 @ 40%.
    ============================================================================
     Struktur:
       DrawerLayout
         └─ CoordinatorLayout
              ├─ AppBarLayout + MaterialToolbar   (back | judul tengah | burger)
              ├─ NestedScrollView (paddingBottom 220dp — bebas dock)
              │    ├─ Meta & status banner : titik hijau + tanggal diperbarui
              │    ├─ Hero / bento card     : ikon masjid, judul, subjudul,
              │    │                          peran PPAIW
              │    ├─ Tentang AIW           : fungsi hukum + strip regulasi
              │    ├─ Berkas 1–3            : row bernomor (lingkar teal)
              │    ├─ Timeline 4 langkah    : dashed + langkah-4 emas (Selesai)
              │    └─ Info biaya            : banner "Layanan Tanpa Pungutan"
              └─ layout_bottom_sticky  (dock aksi + teks bantuan + bottom nav)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".WakafActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/wakaf_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <!-- Judul tengah + subjudul KUA (custom center view) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wakaf_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wakaf_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="220dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp">

                <!-- ============ 1. META & STATUS BANNER ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rekom_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <!-- Indikator layanan aktif: titik hijau + label -->
                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_status_online" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wakaf_status_layanan"
                        android:textColor="@color/badge_emerald_text"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="end|center_vertical"
                        android:maxLines="1"
                        android:text="@string/wakaf_diperbarui"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        app:drawableEndCompat="@drawable/ic_schedule"
                        app:drawableTint="@color/text_tertiary" />
                </LinearLayout>

                <!-- ============ 2. HERO / SUMMARY BENTO CARD ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Ikon masjid + judul & subjudul -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_rekom_icon_teal_soft"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/ic_mosque"
                            app:tint="@color/md3_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/wakaf_hero_title"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/wakaf_hero_subtitle"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Penjelasan resmi peran KUA sebagai PPAIW -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/wakaf_hero_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ============ 3. TENTANG AKTA IKRAR WAKAF (AIW) ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:text="@string/wakaf_aiw_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_policy_shield"
                    app:drawableTint="@color/md3_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/wakaf_aiw_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Strip landasan regulasi -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rekom_info_blue"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/wakaf_aiw_regulasi"
                        android:textColor="@color/md3_info_blue_text"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_description"
                        app:drawableTint="@color/md3_info_blue_text" />
                </LinearLayout>

                <!-- ============ 4. YANG PERLU DISIAPKAN (3 BERKAS BERNOMOR) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wakaf_siap_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Badge jumlah berkas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_badge_teal"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/wakaf_siap_badge"
                        android:textColor="@color/badge_teal_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/wakaf_siap_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp">

                    <!-- Berkas 1 — Identitas Wakif -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WakafBerkasNumber"
                            android:text="@string/rekom_step_1_number" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wakaf_berkas_1_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wakaf_berkas_1_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Berkas 2 — Bukti Kepemilikan Tanah / Harta -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WakafBerkasNumber"
                            android:text="@string/rekom_step_2_number" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wakaf_berkas_2_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wakaf_berkas_2_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Berkas 3 — Identitas Nadzir -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WakafBerkasNumber"
                            android:text="@string/rekom_step_3_number" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/wakaf_berkas_3_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/wakaf_berkas_3_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 5. LANGKAH (TIMELINE 4 TAHAPAN) ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/wakaf_langkah_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/wakaf_langkah_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <!-- Langkah 1 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tv_step_1"
                        style="@style/RekomStepNumber"
                        android:text="@string/rekom_step_1_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rekom_dashed_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_1"
                        app:layout_constraintStart_toStartOf="@id/tv_step_1"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_1" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_surface_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_1"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/wakaf_langkah_1_title" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/wakaf_langkah_1_desc" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 2 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_step_2"
                        style="@style/RekomStepNumber"
                        android:text="@string/rekom_step_2_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rekom_dashed_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_2"
                        app:layout_constraintStart_toStartOf="@id/tv_step_2"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_2" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_surface_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_2"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/wakaf_langkah_2_title" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/wakaf_langkah_2_desc" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 3 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_step_3"
                        style="@style/RekomStepNumber"
                        android:text="@string/rekom_step_3_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rekom_dashed_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_3"
                        app:layout_constraintStart_toStartOf="@id/tv_step_3"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_3" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_surface_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_3"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/wakaf_langkah_3_title" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/wakaf_langkah_3_desc" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 4 — highlight sekunder emas (AIW terbit: Selesai) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_step_4"
                        style="@style/RekomStepNumber"
                        android:text="4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_secondary_container"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_4"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/syarat_accent_gold"
                        app:strokeWidth="1dp">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/wakaf_langkah_4_title"
                                android:textColor="@color/md3_secondary" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/wakaf_langkah_4_desc"
                                android:textColor="@color/md3_secondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ============ 6. INFO BOX BIAYA (TANPA PUNGUTAN) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_rekom_garansi_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wallet"
                        app:tint="@color/md3_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/wakaf_pungli_title"
                            android:textColor="@color/md3_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/wakaf_pungli_desc"
                            android:textColor="@color/md3_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gold"
                        android:fontFamily="sans-serif-black"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="@string/syarat_biaya_rp0"
                        android:textColor="@color/md3_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STICKY BOTTOM: DOCK AKSI + BOTTOM NAV ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/md3_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <!-- Contextual action tray -->
            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sarana_keagamaan"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wakaf_btn_sarana"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_primary"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_location"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_primary"
                        app:strokeColor="@color/md3_primary"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_konsultasi"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wakaf_btn_konsultasi"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@color/md3_primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_chat"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_on_primary" />
                </LinearLayout>

                <!-- Tautan bantuan petugas -> WhatsApp resmi -->
                <TextView
                    android:id="@+id/tv_bantuan_petugas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/wakaf_bantuan_petugas"
                    android:textColor="@color/md3_primary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_help_center"
                    app:drawableTint="@color/md3_primary" />
            </LinearLayout>

            <!-- Bottom Navigation Persistent (5 tab, Layanan aktif) -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
