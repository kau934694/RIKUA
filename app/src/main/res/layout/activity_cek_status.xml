<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_cek_status.xml
     Layar "Cek Status Pendaftaran" (tracking berkas) KUA Kec. Randudongkal.
     Scaffold MD3: TopAppBar sticky (judul + subjudul + back + menu drawer),
     kartu input pencarian (nomor tiket + tanggal lahir + tombol Cek Status),
     empty-state, kartu hasil (identitas pasangan + badge status + timeline
     5 tahap + catatan petugas & aksi unggah ulang), section bantuan (WhatsApp
     + banner transparansi bebas pungli), bottom nav persisten + drawer 12 menu.
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".CekStatusActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/cek_status_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/cs_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/cs_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="96dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp">

                <!-- ============ 1. KARTU INPUT PENCARIAN ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/md3_surface_container_low"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/syarat_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_rekom_icon_teal_soft"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_search"
                                app:tint="@color/md3_primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/cs_input_title"
                                    android:textColor="@color/md3_on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/cs_input_subtitle"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Input 1: Nomor tiket -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_kode_tiket"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/cs_hint_kode_tiket"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:helperText="@string/cs_help_kode_tiket"
                            app:helperTextEnabled="true"
                            app:startIconContentDescription="@null"
                            app:startIconDrawable="@drawable/ic_badge"
                            app:startIconTint="@color/md3_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_kode_tiket"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="textCapCharacters"
                                android:maxLength="16"
                                android:textColor="@color/md3_on_surface"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Input 2: Tanggal lahir (picker) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_tanggal_lahir"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/cs_hint_tanggal_lahir"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:startIconContentDescription="@null"
                            app:startIconDrawable="@drawable/ic_calendar"
                            app:startIconTint="@color/md3_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_tanggal_lahir"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:fontFamily="monospace"
                                android:hint="@string/cs_ph_tanggal_lahir"
                                android:inputType="none"
                                android:textColor="@color/md3_on_surface"
                                android:textSize="15sp"
                                tools:ignore="KeyboardAccessibleLabel" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Tombol utama -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cek_status"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/cs_btn_cek"
                            android:textAllCaps="false"
                            android:textColor="@color/md3_on_primary"
                            android:textSize="15sp"
                            app:backgroundTint="@color/md3_primary_container"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_search"
                            app:iconGravity="start"
                            app:iconSize="18dp"
                            app:iconTint="@color/md3_on_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 2. EMPTY STATE ============ -->
                <LinearLayout
                    android:id="@+id/layout_kosong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/md3_card_outlined"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_rekom_icon_teal_soft"
                        android:contentDescription="@null"
                        android:padding="12dp"
                        android:src="@drawable/ic_description"
                        app:tint="@color/md3_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/cs_empty_title"
                        android:textColor="@color/md3_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/cs_empty_desc"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ============ 3. KARTU HASIL PELACAKAN ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_hasil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/md3_surface_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/syarat_card_border"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header: judul + badge status -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/cs_result_title"
                                android:textColor="@color/md3_on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_badge_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_s5_badge_amber"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.03"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp"
                                android:text="@string/cs_badge_perlu_perbaikan"
                                android:textColor="@color/s5_amber_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Identitas pasangan + tiket + tanggal -->
                        <TextView
                            android:id="@+id/tv_hasil_pasangan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/md3_on_surface"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="Ahmad Fauzi &amp; Siti Nurhaliza" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cs_label_tiket"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/s6_val_kosong"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_hasil_tiket"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/md3_on_surface_variant"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="RKA-2026-00123" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cs_label_daftar"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/s6_val_kosong"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_hasil_daftar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/md3_on_surface_variant"
                                android:textSize="12sp"
                                tools:text="12 Januari 2026" />
                        </LinearLayout>

                        <!-- Timeline tracking -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/cs_timeline_title"
                            android:textColor="@color/md3_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/container_timeline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                        <!-- Kartu catatan petugas -->
                        <LinearLayout
                            android:id="@+id/card_catatan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_notice_amber"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_warning"
                                    app:tint="@color/s5_amber_text" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/cs_catatan_title"
                                    android:textColor="@color/s5_amber_text"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_catatan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/s5_amber_text"
                                android:textSize="12sp"
                                tools:text="Pindai KTP istri buram, mohon unggah ulang dengan resolusi lebih tinggi." />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/cs_pemeriksa_label"
                                android:textColor="@color/s5_amber_text"
                                android:textSize="10sp"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tv_pemeriksa"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/s5_amber_text"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Zaenal Arifin, S.Ud" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_unggah_ulang"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/cs_btn_unggah_ulang"
                                android:textAllCaps="false"
                                android:textColor="@color/md3_on_primary"
                                android:textSize="13sp"
                                app:backgroundTint="@color/md3_primary_container"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_upload"
                                app:iconGravity="start"
                                app:iconSize="18dp"
                                app:iconTint="@color/md3_on_primary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 4. SECTION BANTUAN ============ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wa"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/cs_btn_wa"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    app:backgroundTint="@color/whatsapp_brand"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_whatsapp"
                    app:iconGravity="start"
                    app:iconSize="20dp"
                    app:iconTint="@color/text_white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_rekom_garansi_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_policy_shield"
                        app:tint="@color/gold_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/cs_transparansi_title"
                            android:textColor="@color/gold_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/cs_transparansi_desc"
                            android:textColor="@color/syarat_accent_brown"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ BOTTOM NAV PERSISTEN ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/surface_white"
            android:elevation="10dp"
            android:orientation="vertical">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER (12 MENU) =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:menu="@menu/daftar_nikah_drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
