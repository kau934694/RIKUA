<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_syarat_nikah.xml (REDESIGN Material Design 3)
     Halaman "Syarat Nikah" KUA Kec. Randudongkal
     Palette: primary #0F6B5C, background #F6F8F7, card #FFFFFF border #E5E9E7,
              aksen khusus #795902 / #C9A24B. Font: sans-serif (Plus Jakarta
              Sans dapat dipasang via res/font tanpa mengubah struktur).
    ============================================================================
     Struktur:
       DrawerLayout
         └─ CoordinatorLayout
              ├─ AppBarLayout + MaterialToolbar   (sticky; back | judul tengah | burger)
              ├─ NestedScrollView
              │    ├─ LinearProgressIndicator     (state loading API)
              │    ├─ layout_content
              │    │    ├─ Summary card   : badge "Resmi Kemenag", diperbarui,
              │    │    │                   judul, deskripsi, strip biaya Rp 0
              │    │    ├─ Progress checklist persiapan berkas
              │    │    ├─ Accordion section 1 "Untuk Semua Pendaftar" (umum)
              │    │    ├─ Accordion section 2 "Jika Berlaku untuk Anda" (khusus)
              │    │    ├─ Timeline "Langkah Pendaftaran" (5 langkah, dinamis)
              │    │    ├─ Banner bantuan konsultasi petugas (08.00–15.00 WIB)
              │    │    └─ Catatan anti-pungli
              │    └─ layout_error          (gagal muat + retry)
              └─ layout_bottom_sticky       (elevation, gravity=bottom)
                   ├─ Panel aksi: Daftar Nikah (filled) + Unduh Blanko (outlined)
                   │  + tautan "Butuh bantuan? Konsultasi dengan petugas"
                   └─ BottomNavigationView 5 tab (Layanan aktif — pill indicator)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".SyaratNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/syarat_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/syarat_background">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/syarat_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/syarat_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/syarat_on_primary">

                <!-- Judul tengah + sub-teks KUA (custom center view MD3) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/syarat_toolbar_title"
                        android:textColor="@color/syarat_on_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/syarat_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="220dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Indikator pemuatan data (tampil saat fetch API berjalan) -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/syarat_primary"
                    app:trackThickness="4dp"
                    tools:visibility="visible" />

                <!-- ============ Konten utama (disembunyikan bila gagal muat) ============ -->
                <LinearLayout
                    android:id="@+id/layout_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ===== 1. INSTITUTIONAL SUMMARY CARD ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_syarat_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Judul layanan (dinamis dari tabel layanan) -->
                        <TextView
                            android:id="@+id/tv_layanan_judul"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/syarat_summary_title"
                            android:textColor="@color/text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <!-- Deskripsi layanan -->
                        <TextView
                            android:id="@+id/tv_layanan_deskripsi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/syarat_summary_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <!-- Chip estimasi proses (dinamis) -->
                        <TextView
                            android:id="@+id/tv_estimasi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_badge_teal"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/badge_teal_text"
                            android:textSize="11sp"
                            tools:text="Estimasi proses: 15-30 menit" />

                        <!-- Strip catatan biaya: "Biaya Nikah di KUA: Rp 0 (Gratis) | Hari Kerja" -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_syarat_biaya_strip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_verified"
                                app:tint="@color/syarat_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/syarat_biaya_note_prefix"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_biaya"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/syarat_biaya_rp0"
                                android:textColor="@color/syarat_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_biaya_catatan"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/syarat_biaya_note_suffix"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <!-- Badge GRATIS; diganti teks institusi bila layanan berbiaya -->
                            <TextView
                                android:id="@+id/tv_badge_gratis"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_status_active"
                                android:fontFamily="sans-serif-medium"
                                android:paddingStart="9dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="9dp"
                                android:paddingBottom="4dp"
                                android:text="@string/syarat_badge_gratis"
                                android:textColor="@color/status_green_dark"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ===== 2. PROGRESS CHECKLIST BERKAS ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_progress_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="0 dari 11 syarat sudah disiapkan" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_checklist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:indicatorColor="@color/syarat_primary"
                            app:trackCornerRadius="6dp"
                            app:trackColor="@color/syarat_primary_soft"
                            app:trackThickness="8dp" />
                    </LinearLayout>

                    <!-- ===== 3. ACCORDION SECTION 1: UNTUK SEMUA PENDAFTAR ===== -->
                    <include
                        android:id="@+id/section_umum"
                        layout="@layout/section_syarat_header" />

                    <LinearLayout
                        android:id="@+id/container_syarat_umum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="18dp"
                        android:orientation="vertical"
                        tools:layout_height="wrap_content" />

                    <!-- ===== 4. ACCORDION SECTION 2: JIKA BERLAKU UNTUK ANDA ===== -->
                    <include
                        android:id="@+id/section_khusus"
                        layout="@layout/section_syarat_header" />

                    <LinearLayout
                        android:id="@+id/container_syarat_khusus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="18dp"
                        android:orientation="vertical" />

                    <!-- ===== 5. TIMELINE "LANGKAH PENDAFTARAN" ===== -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="26dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/syarat_langkah_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_langkah_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="20dp"
                        android:text="@string/syarat_langkah_hint_5"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        tools:text="5 langkah dari persiapan berkas hingga buku nikah terbit" />

                    <LinearLayout
                        android:id="@+id/container_langkah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="18dp"
                        android:orientation="vertical" />

                    <!-- ===== 6. BANNER BANTUAN KONSULTASI PETUGAS ===== -->
                    <LinearLayout
                        android:id="@+id/card_bantuan_harian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="22dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_syarat_notice_gold"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_badge_gold">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chat"
                                app:tint="@color/syarat_accent_brown" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/syarat_notice_title"
                                android:textColor="@color/syarat_accent_brown"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="3"
                                android:text="@string/syarat_notice_desc"
                                android:textColor="@color/syarat_accent_brown"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btn_notice_konsultasi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_syarat_badge_resmi"
                            android:fontFamily="sans-serif-medium"
                            android:minHeight="40dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/syarat_notice_btn"
                            android:textColor="@color/syarat_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- ===== 7. CATATAN ANTI-PUNGLI ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_notice_amber"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_policy_shield"
                            app:tint="@color/gold_dark" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/syarat_footer_note"
                            android:textColor="@color/gold_dark"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== STATE GAGAL MUAT DATA ===== -->
                <LinearLayout
                    android:id="@+id/layout_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_close"
                        app:tint="@color/badge_rose_text" />

                    <TextView
                        android:id="@+id/tv_error_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/syarat_error_default"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_retry"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/syarat_btn_retry"
                        android:textColor="@color/syarat_primary"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/syarat_primary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- =================== STICKY BOTTOM: AKSI + NAVIGASI =================== -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/syarat_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <!-- Panel tombol aksi utama -->
            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_daftar_nikah"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.15"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/syarat_btn_daftar"
                        android:textAllCaps="false"
                        android:textColor="@color/syarat_on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@color/syarat_primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="end"
                        app:iconSize="18dp"
                        app:iconTint="@color/syarat_on_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_unduh_blanko"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/syarat_btn_unduh_blanko"
                        android:textAllCaps="false"
                        android:textColor="@color/syarat_primary"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/syarat_primary"
                        app:strokeColor="@color/syarat_primary"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>

                <!-- Tautan teks bantuan petugas -->
                <TextView
                    android:id="@+id/tv_bantuan_petugas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/syarat_bantuan_link"
                    android:textColor="@color/syarat_primary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_help_center"
                    app:drawableTint="@color/syarat_primary" />
            </LinearLayout>

            <!-- Bottom Navigation Persistent (5 tab, Layanan aktif) -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
