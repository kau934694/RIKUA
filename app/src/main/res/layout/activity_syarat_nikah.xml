<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".SyaratNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/syarat_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/syarat_background">

        <!-- AppBar: Hanya Toolbar hijau yang diam di atas -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/syarat_primary"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/syarat_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="Kembali"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/syarat_on_primary">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Syarat Nikah"
                        android:textColor="@color/syarat_on_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.02"
                        android:text="KUA Kec. Randudongkal"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="190dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- State muat -->
                <LinearLayout
                    android:id="@+id/progress_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorColor="@color/syarat_primary"
                        app:trackThickness="4dp" />

                    <TextView
                        style="@style/SyaratCaption"
                        android:layout_marginTop="10dp"
                        android:text="Memuat daftar persyaratan..." />
                </LinearLayout>

                <!-- KONTEN UTAMA (Ikut ter-scroll semuanya) -->
                <LinearLayout
                    android:id="@+id/layout_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Hero ringkasan layanan: latar putih & ikut ter-scroll -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_search_field"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_layanan_judul"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="Syarat Nikah"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_layanan_deskripsi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Silakan lengkapi berkas persyaratan administrasi berikut sebelum mendaftar di KUA Randudongkal."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <!-- Legalitas -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_verified"
                                app:tint="@color/syarat_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.04"
                                android:text="RESMI KEMENTERIAN AGAMA RI"
                                android:textAllCaps="true"
                                android:textColor="@color/syarat_primary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <!-- Section accordion umum & khusus -->
                    <include
                        android:id="@+id/section_umum"
                        layout="@layout/section_syarat_header" />

                    <LinearLayout
                        android:id="@+id/container_syarat_umum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <include
                        android:id="@+id/section_khusus"
                        layout="@layout/section_syarat_header" />

                    <LinearLayout
                        android:id="@+id/container_syarat_khusus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <!-- Timeline langkah pendaftaran -->
                    <View
                        style="@style/SyaratGoldRule"
                        android:layout_marginTop="28dp" />

                    <TextView
                        style="@style/SyaratSectionTitle"
                        android:layout_marginTop="10dp"
                        android:text="Langkah Pendaftaran" />

                    <TextView
                        android:id="@+id/tv_langkah_subtitle"
                        style="@style/SyaratCaption"
                        android:layout_width="match_parent"
                        android:layout_marginTop="2dp"
                        android:text="5 tahapan pendaftaran"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/container_langkah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                    <!-- Banner bantuan konsultasi petugas -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_bantuan_harian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:cardBackgroundColor="@color/gold_container"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/gold_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_badge_gold"
                                    android:contentDescription="@null"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_chat"
                                    app:tint="@color/syarat_accent_brown" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="Butuh Bantuan Melengkapi Berkas?"
                                    android:textColor="@color/syarat_accent_brown"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="2dp"
                                android:text="Konsultasikan kelengkapan dokumen Anda bersama petugas KUA pada hari kerja pukul 08.00–15.00 WIB."
                                android:textColor="@color/syarat_accent_brown"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_notice_konsultasi"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:minHeight="44dp"
                                android:text="Tanya Petugas KUA"
                                android:textAllCaps="false"
                                android:textColor="@color/syarat_primary"
                                android:textSize="13sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_chat"
                                app:iconGravity="start"
                                app:iconSize="16dp"
                                app:iconTint="@color/syarat_primary"
                                app:strokeColor="@color/syarat_primary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Catatan anti-pungli -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_notice_amber"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ic_policy_shield"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_policy_shield"
                            app:tint="@color/gold_dark" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="Seluruh proses verifikasi berkas di KUA bebas dari pungutan liar (pungli)."
                            android:textColor="@color/gold_dark"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- State error -->
                <LinearLayout
                    android:id="@+id/layout_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_close"
                        app:tint="@color/badge_rose_text" />

                    <TextView
                        android:id="@+id/tv_error_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="Gagal memuat data persyaratan."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_retry"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="Coba Lagi"
                        android:textColor="@color/syarat_primary"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/syarat_primary" />
                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Panel aksi sticky -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/surface_white"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_daftar_nikah"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="52dp"
                    android:paddingHorizontal="8dp"
                    android:text="Daftar Nikah"
                    android:textAllCaps="false"
                    android:textColor="@color/syarat_on_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/syarat_primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="end"
                    app:iconSize="16dp"
                    app:iconTint="@color/syarat_on_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_unduh_blanko"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.2"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:minHeight="52dp"
                    android:paddingHorizontal="8dp"
                    android:text="Unduh Blanko"
                    android:textAllCaps="false"
                    android:textColor="@color/syarat_primary"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="start"
                    app:iconSize="16dp"
                    app:iconTint="@color/syarat_primary"
                    app:strokeColor="@color/syarat_primary"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Rikua.BottomNav.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>