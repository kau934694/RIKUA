<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".FacilityDetailActivity">

    <!-- =================== MAIN CONTENT =================== -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/detail_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_cream_light">

        <!-- =================== APP BAR =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/consult_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/consult_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:navigationContentDescription="@string/facility_detail_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/text_white"
                app:subtitle="@string/facility_detail_toolbar_subtitle"
                app:subtitleTextColor="@color/gold_accent"
                app:title="@string/facility_detail_toolbar_title"
                app:titleTextColor="@color/text_white" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="92dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- === 1. HEADER IMAGE (Glide) === -->
                <FrameLayout
                    android:id="@+id/header_image_container"
                    android:layout_width="match_parent"
                    android:layout_height="240dp">

                    <ImageView
                        android:id="@+id/iv_header_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/primary_forest_container"
                        android:contentDescription="@string/facility_thumb_desc"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/ic_mosque" />

                    <!-- Scrim bawah untuk keterbacaan badge -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_gravity="bottom"
                        android:background="#6600201B" />

                    <!-- Category badge (kiri bawah) -->
                    <TextView
                        android:id="@+id/tv_category_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|bottom"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_badge_emerald"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/badge_emerald_text"
                        android:textSize="12sp"
                        tools:text="Masjid Jami'" />

                    <!-- Status badge (kanan bawah) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_status_active"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_status_online" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/facility_detail_status_active"
                            android:textColor="@color/status_green_dark"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- === 2. TITLE + SIMAS + LOKASI RINGKAS === -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:id="@+id/tv_facility_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Masjid Besar Baitul Muttaqin" />

                    <TextView
                        android:id="@+id/tv_simas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:textColor="@color/consult_primary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_verified"
                        app:drawableTint="@color/gold_dark"
                        tools:text="SIMAS Kemenag: 0212300101000001" />

                    <TextView
                        android:id="@+id/tv_location_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_location"
                        app:drawableTint="@color/consult_primary"
                        tools:text="Desa Randudongkal, Kec. Randudongkal, Kab. Pemalang" />
                </LinearLayout>

                <!-- === 3. TOMBOL AKSI (MAPS + WHATSAPP) === -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="18dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_maps"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/facility_detail_btn_maps"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white"
                        android:textSize="13sp"
                        app:backgroundTint="@color/consult_primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_location"
                        app:iconGravity="start"
                        app:iconTint="@color/text_white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_consult_wakaf"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/facility_detail_btn_consult"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white"
                        android:textSize="13sp"
                        app:backgroundTint="@color/whatsapp_brand"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_whatsapp"
                        app:iconGravity="start"
                        app:iconTint="@color/text_white" />
                </LinearLayout>

                <!-- === 4. SECTION: IDENTITAS SARANA === -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="@string/facility_detail_section_identity"
                    android:textColor="@color/consult_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_detail_section"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Kategori -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_mosque" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_category" />

                            <TextView
                                android:id="@+id/tv_val_category"
                                style="@style/DetailRowValue"
                                tools:text="Masjid Jami'" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/DetailRowDivider" />

                    <!-- Alamat -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_location" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_address" />

                            <TextView
                                android:id="@+id/tv_val_address"
                                style="@style/DetailRowValue"
                                tools:text="Jl. Dusun II, Randudongkal, Pemalang" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/DetailRowDivider" />

                    <!-- Tahun Berdiri -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_schedule" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_year" />

                            <TextView
                                android:id="@+id/tv_val_year"
                                style="@style/DetailRowValue"
                                tools:text="1987" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- === 5. SECTION: KAPASITAS & LEGALITAS === -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="@string/facility_detail_section_capacity"
                    android:textColor="@color/consult_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_detail_section"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Kapasitas -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_person_circle" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_capacity" />

                            <TextView
                                android:id="@+id/tv_val_capacity"
                                style="@style/DetailRowValue"
                                tools:text="±1.200 jamaah" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/DetailRowDivider" />

                    <!-- Luas Bangunan -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_school" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_building" />

                            <TextView
                                android:id="@+id/tv_val_building"
                                style="@style/DetailRowValue"
                                tools:text="800 m²" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/DetailRowDivider" />

                    <!-- Legalitas Tanah -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_description" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_land" />

                            <TextView
                                android:id="@+id/tv_val_land"
                                style="@style/DetailRowValue"
                                tools:text="Sertifikat Wakaf (AIW)" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/DetailRowDivider" />

                    <!-- Arah Kiblat -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_compass" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_qibla" />

                            <TextView
                                android:id="@+id/tv_val_qibla"
                                style="@style/DetailRowValue"
                                tools:text="24° 52' Utara-Barat Laut" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- === 6. SECTION: PENGURUS & KONTAK === -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="@string/facility_detail_section_management"
                    android:textColor="@color/consult_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_detail_section"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Ketua Takmir -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_person_circle" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_takmir" />

                            <TextView
                                android:id="@+id/tv_val_takmir"
                                style="@style/DetailRowValue"
                                tools:text="H. Sulaiman" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/DetailRowDivider" />

                    <!-- Telepon -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_phone" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_phone" />

                            <TextView
                                android:id="@+id/tv_val_phone"
                                style="@style/DetailRowValue"
                                tools:text="0812-3456-7890" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/DetailRowDivider" />

                    <!-- Email -->
                    <LinearLayout style="@style/DetailRow">

                        <FrameLayout style="@style/DetailRowIconFrame">

                            <ImageView
                                style="@style/DetailRowIcon"
                                android:src="@drawable/ic_chat" />
                        </FrameLayout>

                        <LinearLayout style="@style/DetailRowText">

                            <TextView
                                style="@style/DetailRowLabel"
                                android:text="@string/facility_detail_lbl_email" />

                            <TextView
                                android:id="@+id/tv_val_email"
                                style="@style/DetailRowValue"
                                tools:text="masjid@rikua.id" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- === 7. FOOTER NOTE === -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_trust_strip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/gold_dark" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/facility_detail_footer_note"
                        android:textColor="@color/gold_dark"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- === BOTTOM NAVIGATION BAR === -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_gravity="bottom"
            android:background="@color/surface_white"
            app:elevation="10dp"
            app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
            app:itemIconTint="@color/bottom_nav_color_selector"
            app:itemRippleColor="@color/primary_forest_container"
            app:itemTextColor="@color/bottom_nav_color_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- === NAVIGATION DRAWER (end gravity) === -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
