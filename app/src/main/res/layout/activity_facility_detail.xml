<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".FacilityDetailActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/detail_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_cream_light">

        <!-- Hero foto menyatu dengan toolbar: membesar saat diam, collapse ke hijau saat scroll -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@color/consult_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/primary_forest_container"
                app:contentScrim="@color/consult_primary"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:statusBarScrim="@android:color/transparent"
                app:titleEnabled="false">

                <FrameLayout
                    android:id="@+id/header_image_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_collapseMode="parallax">

                    <ImageView
                        android:id="@+id/iv_header_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/facility_thumb_desc"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/ic_mosque" />

                    <!-- Scrim atas: keterbacaan tombol kembali & judul di atas foto -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_gravity="top"
                        android:background="@drawable/bg_detail_top_scrim" />

                    <!-- Scrim bawah: keterbacaan badge kategori & status -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_gravity="bottom"
                        android:background="#6600201B" />

                    <TextView
                        android:id="@+id/tv_category_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|bottom"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_badge_emerald"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/badge_emerald_text"
                        android:textSize="12sp"
                        tools:text="Masjid Jami'" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_status_active"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_status_online" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/facility_detail_status_active"
                            android:textColor="@color/status_green_dark"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:contentInsetStartWithNavigation="0dp"
                    app:layout_collapseMode="pin"
                    app:navigationContentDescription="@string/facility_detail_back"
                    app:navigationIcon="@drawable/ic_arrow_back"
                    app:navigationIconTint="@color/text_white"
                    app:subtitle="@string/facility_detail_toolbar_subtitle"
                    app:subtitleTextColor="@color/gold_accent"
                    app:title="@string/facility_detail_toolbar_title"
                    app:titleTextColor="@color/text_white" />
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/content_bottom_inset"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Identitas: nama jadi fokus, pendukung proporsional -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/page_gutter"
                    android:paddingTop="20dp"
                    android:paddingEnd="@dimen/page_gutter">

                    <TextView
                        android:id="@+id/tv_facility_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Masjid Besar Baitul Muttaqin" />

                    <TextView
                        android:id="@+id/tv_simas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:textColor="@color/consult_primary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_verified"
                        app:drawableTint="@color/gold_dark"
                        tools:text="SIMAS Kemenag: 0212300101000001" />

                    <TextView
                        android:id="@+id/tv_location_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_location"
                        app:drawableTint="@color/consult_primary"
                        tools:text="Desa Randudongkal, Kec. Randudongkal, Kab. Pemalang" />
                </LinearLayout>

                <!-- Dua aksi setara berdampingan, tap 48dp -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_maps"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="13sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0"
                        android:text="@string/facility_detail_btn_maps"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white"
                        app:backgroundTint="@color/consult_primary"
                        app:cornerRadius="@dimen/radius_control"
                        app:icon="@drawable/ic_location"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_white"
                        app:rippleColor="@color/primary_forest" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_consult_wakaf"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="13sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0"
                        android:text="@string/facility_detail_btn_consult"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white"
                        app:backgroundTint="@color/whatsapp_brand_dark"
                        app:cornerRadius="@dimen/radius_control"
                        app:icon="@drawable/ic_whatsapp"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_white" />
                </LinearLayout>

                <!-- Spec sheet: satu permukaan, tiga grup, label kiri nilai kanan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:background="@drawable/bg_detail_sheet"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SpecGroupTitle"
                            android:text="@string/facility_detail_section_identity" />

                        <View style="@style/SpecGroupRule" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_category" />

                        <TextView
                            android:id="@+id/tv_val_category"
                            style="@style/SpecRowValue"
                            tools:text="Masjid Jami'" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRowStack">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_address" />

                        <TextView
                            android:id="@+id/tv_val_address"
                            style="@style/SpecRowValueStack"
                            tools:text="Jl. Dusun II No. 12, Randudongkal, Pemalang" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_year" />

                        <TextView
                            android:id="@+id/tv_val_year"
                            style="@style/SpecRowValue"
                            tools:text="1987" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_qibla" />

                        <TextView
                            android:id="@+id/tv_val_qibla"
                            style="@style/SpecRowValue"
                            tools:text="24° 52' Utara-Barat Laut" />
                    </LinearLayout>

                    <View style="@style/SpecDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SpecGroupTitle"
                            android:text="@string/facility_detail_section_capacity" />

                        <View style="@style/SpecGroupRule" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_capacity" />

                        <TextView
                            android:id="@+id/tv_val_capacity"
                            style="@style/SpecRowValue"
                            tools:text="±1.200 jamaah" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_building" />

                        <TextView
                            android:id="@+id/tv_val_building"
                            style="@style/SpecRowValue"
                            tools:text="800 m²" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_land" />

                        <TextView
                            android:id="@+id/tv_val_land"
                            style="@style/SpecRowValue"
                            tools:text="Sertifikat Wakaf (AIW)" />
                    </LinearLayout>

                    <View style="@style/SpecDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SpecGroupTitle"
                            android:text="@string/facility_detail_section_management" />

                        <View style="@style/SpecGroupRule" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_takmir" />

                        <TextView
                            android:id="@+id/tv_val_takmir"
                            style="@style/SpecRowValue"
                            tools:text="H. Sulaiman" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_phone" />

                        <TextView
                            android:id="@+id/tv_val_phone"
                            style="@style/SpecRowValue"
                            tools:text="0812-3456-7890" />
                    </LinearLayout>

                    <LinearLayout style="@style/SpecRow">

                        <TextView
                            style="@style/SpecRowLabel"
                            android:text="@string/facility_detail_lbl_email" />

                        <TextView
                            android:id="@+id/tv_val_email"
                            style="@style/SpecRowValue"
                            tools:text="masjid@rikua.id" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Catatan verifikasi: inline, menyatu halaman -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_gutter"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="@dimen/page_gutter"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/gold_dark" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/facility_detail_footer_note"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_gravity="bottom"
            android:background="@color/surface_white"
            app:elevation="4dp"
            app:itemActiveIndicatorStyle="@style/Widget.Rikua.BottomNav.ActiveIndicator"
            app:itemIconTint="@color/bottom_nav_color_selector"
            app:itemRippleColor="@color/primary_forest_container"
            app:itemTextColor="@color/bottom_nav_color_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
