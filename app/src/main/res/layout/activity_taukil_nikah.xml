<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_taukil_nikah.xml
     Halaman "Taukil Wali bil Kitabah" (pelimpahan wali secara tertulis) MD3
     Palette: primary #005145 / #0f6b5c, container #a2f2de, secondary #795902 /
              #fdd275, surface #f7f9ff, card #ffffff, border #bec9c5 @ 40%.
    ============================================================================
     Struktur:
       DrawerLayout
         └─ CoordinatorLayout
              ├─ AppBarLayout + MaterialToolbar   (back | judul tengah | burger)
              ├─ NestedScrollView (paddingBottom 220dp — bebas dock)
              │    ├─ Hero / summary card : badge resmi + diperbarui, label
              │    │                        "Panduan Kepenghuluan" (emas),
              │    │                        judul, subjudul, penjelasan taukil
              │    ├─ Grid 2x2 "Kapan Diperlukan?" : 4 kartu kondisi
              │    ├─ Dokumen 1–3         : row bernomor (lingkar teal)
              │    ├─ Timeline 3 langkah  : dashed + langkah-3 emas (akad)
              │    └─ Alert box           : konsultasi gratis tanpa pungutan
              └─ layout_bottom_sticky  (dock aksi + teks bantuan + bottom nav)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".TaukilNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/taukil_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <!-- Judul tengah + subjudul KUA (custom center view) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/taukil_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/taukil_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="220dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp">

                <!-- ============ 1. METADATA + HERO / SUMMARY CARD ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Badge resmi + tanggal pembaruan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rekom_badge_official"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_verified"
                                app:tint="@color/badge_emerald_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/taukil_badge_resmi"
                                android:textColor="@color/badge_emerald_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:drawablePadding="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="@string/taukil_diperbarui"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"
                            app:drawableEndCompat="@drawable/ic_schedule"
                            app:drawableTint="@color/text_tertiary" />
                    </LinearLayout>

                    <!-- Label aksen sekunder (overline) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/taukil_hero_label"
                        android:textAllCaps="true"
                        android:textColor="@color/md3_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/taukil_hero_title"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/taukil_hero_subtitle"
                        android:textColor="@color/md3_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/taukil_hero_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ============ 2. KAPAN DIPERLUKAN? (GRID 2x2) ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:text="@string/taukil_kapan_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_help_center"
                    app:drawableTint="@color/md3_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/taukil_kapan_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <!-- Baris 1 kartu: Jarak Jauh | Kondisi Sakit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/TaukilGridCard"
                        android:layout_width="0dp"
                        android:layout_weight="1">

                        <ImageView
                            style="@style/TaukilGridIcon"
                            android:src="@drawable/ic_location" />

                        <TextView
                            style="@style/TaukilGridTitle"
                            android:text="@string/taukil_kapan_1_title" />

                        <TextView
                            style="@style/TaukilGridDesc"
                            android:text="@string/taukil_kapan_1_desc" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/TaukilGridCard"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <ImageView
                            style="@style/TaukilGridIcon"
                            android:src="@drawable/ic_favorite" />

                        <TextView
                            style="@style/TaukilGridTitle"
                            android:text="@string/taukil_kapan_2_title" />

                        <TextView
                            style="@style/TaukilGridDesc"
                            android:text="@string/taukil_kapan_2_desc" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Baris 2 kartu: Tugas Luar Daerah/Negeri | Perwakilan Ijab Kabul -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/TaukilGridCard"
                        android:layout_width="0dp"
                        android:layout_weight="1">

                        <ImageView
                            style="@style/TaukilGridIcon"
                            android:src="@drawable/ic_compass" />

                        <TextView
                            style="@style/TaukilGridTitle"
                            android:text="@string/taukil_kapan_3_title" />

                        <TextView
                            style="@style/TaukilGridDesc"
                            android:text="@string/taukil_kapan_3_desc" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/TaukilGridCard"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <ImageView
                            style="@style/TaukilGridIcon"
                            android:src="@drawable/ic_transfer" />

                        <TextView
                            style="@style/TaukilGridTitle"
                            android:text="@string/taukil_kapan_4_title" />

                        <TextView
                            style="@style/TaukilGridDesc"
                            android:text="@string/taukil_kapan_4_desc" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 3. YANG PERLU DISIAPKAN (3 DOKUMEN BERNOMOR) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/taukil_siap_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Badge jumlah dokumen -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_badge_teal"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/taukil_siap_badge"
                        android:textColor="@color/badge_teal_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/taukil_siap_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp">

                    <!-- Dokumen 1 — Surat Kuasa Taukil -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="@string/rekom_step_1_number" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/taukil_dok_1_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/taukil_dok_1_desc" />
                        </LinearLayout>

                        <TextView
                            style="@style/IsbatBerkasBadge"
                            android:background="@drawable/bg_badge_blue"
                            android:text="@string/isbat_badge_wajib"
                            android:textColor="@color/badge_blue_text" />
                    </LinearLayout>

                    <!-- Dokumen 2 — KTP & KK Wali Nasab -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="@string/rekom_step_2_number" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/taukil_dok_2_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/taukil_dok_2_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Dokumen 3 — KTP Wakil Wali / Penerima Kuasa -->
                    <LinearLayout style="@style/RekomChecklistRow">

                        <TextView
                            style="@style/WaliNasabNumber"
                            android:text="@string/rekom_step_3_number" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                style="@style/RekomChecklistTitle"
                                android:text="@string/taukil_dok_3_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/taukil_dok_3_desc" />
                        </LinearLayout>

                        <TextView
                            style="@style/IsbatBerkasBadge"
                            android:background="@drawable/bg_badge_amber"
                            android:text="@string/taukil_badge_perwakilan"
                            android:textColor="@color/badge_amber_text" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 4. LANGKAH PENGURUSAN (TIMELINE 3 TAHAPAN) ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/taukil_langkah_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/taukil_langkah_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <!-- Langkah 1 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tv_step_1"
                        style="@style/RekomStepNumber"
                        android:text="@string/rekom_step_1_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rekom_dashed_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_1"
                        app:layout_constraintStart_toStartOf="@id/tv_step_1"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_1" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_surface_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_1"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/taukil_langkah_1_title" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/taukil_langkah_1_desc" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 2 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_step_2"
                        style="@style/RekomStepNumber"
                        android:text="@string/rekom_step_2_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rekom_dashed_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_2"
                        app:layout_constraintStart_toStartOf="@id/tv_step_2"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_2" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_surface_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_2"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/taukil_langkah_2_title" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/taukil_langkah_2_desc" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 3 — highlight sekunder emas (akad dilaksanakan) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_step_3"
                        style="@style/RekomStepNumber"
                        android:text="@string/rekom_step_3_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_secondary_container"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_3"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/syarat_accent_gold"
                        app:strokeWidth="1dp">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/taukil_langkah_3_title"
                                android:textColor="@color/md3_secondary" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/taukil_langkah_3_desc"
                                android:textColor="@color/md3_secondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ============ 5. ALERT BOX — KONSULTASI GRATIS ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_rekom_garansi_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_policy_shield"
                        app:tint="@color/md3_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/taukil_note_title"
                            android:textColor="@color/md3_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/taukil_note_desc"
                            android:textColor="@color/md3_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gold"
                        android:fontFamily="sans-serif-black"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="@string/syarat_biaya_rp0"
                        android:textColor="@color/md3_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STICKY BOTTOM: DOCK AKSI + BOTTOM NAV ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/md3_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <!-- Contextual action tray -->
            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lihat_wali"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/taukil_btn_wali"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_primary"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_person_circle"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_primary"
                        app:strokeColor="@color/md3_primary"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_konsultasi"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/taukil_btn_konsultasi"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@color/md3_primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_chat"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_on_primary" />
                </LinearLayout>

                <!-- Tautan bantuan petugas -> WhatsApp resmi -->
                <TextView
                    android:id="@+id/tv_bantuan_petugas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/taukil_bantuan_petugas"
                    android:textColor="@color/md3_primary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_help_center"
                    app:drawableTint="@color/md3_primary" />
            </LinearLayout>

            <!-- Bottom Navigation Persistent (5 tab, Layanan aktif) -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
