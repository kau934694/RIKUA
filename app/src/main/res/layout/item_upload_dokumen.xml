<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_dokumen"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/md3_surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/md3_outline_variant_40"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ===== Baris identitas: ikon + judul/desc + badge status ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_ikon_dokumen"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_rekom_icon_teal_soft"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_description"
                app:tint="@color/md3_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_judul_dokumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Surat Pengantar Nikah (N1)" />

                <TextView
                    android:id="@+id/tv_info_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="1dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="Diterahkan Kepala Desa/Lurah domisili calon" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_badge_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_gray"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/s5_status_belum"
                android:textColor="@color/status_offline_text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ===== Kotak pesan error petugas (hanya Perlu Perbaikan) ===== -->
        <LinearLayout
            android:id="@+id/layout_error_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_s5_error_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                app:tint="@color/s5_amber_text" />

            <TextView
                android:id="@+id/tv_pesan_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/s5_amber_text"
                android:textSize="11sp"
                tools:text="Pindai KTP buram dan nomor NIK tidak terbaca." />
        </LinearLayout>

        <!-- ===== Baris aksi: unggah + foto kamera ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_unggah_file"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/s5_btn_unggah"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/md3_surface_container_low"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_upload"
                app:iconGravity="start"
                app:iconSize="16dp"
                app:iconTint="@color/md3_primary"
                tools:text="Unggah Ulang File" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_kamera"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="46dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/s5_camera_content_desc"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/md3_primary"
                app:strokeColor="@color/md3_outline_variant_40" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
