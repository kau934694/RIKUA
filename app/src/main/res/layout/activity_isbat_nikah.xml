<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_isbat_nikah.xml
     Halaman "Isbat Nikah" (pencatatan nikah yang belum tercatat) MD3
     Palette: primary #005145 / #0f6b5c, container #a2f2de, secondary #795902 /
              #fdd275, surface #f7f9ff, card #ffffff, container-low #edf4ff.
    ============================================================================
     Struktur:
       DrawerLayout
         └─ CoordinatorLayout
              ├─ AppBarLayout + MaterialToolbar   (back | judul tengah | burger)
              ├─ NestedScrollView (paddingBottom 220dp — bebas dock)
              │    ├─ Section banner  : badge resmi, diperbarui, judul, deskripsi,
              │    │                    ringkasan "Sidang PA → Buku Nikah Sah"
              │    ├─ "Kapan Diperlukan?" : 3 kartu kecil poin penjelasan
              │    ├─ Checklist berkas    : badge "4 Berkas" + 4 row interaktif
              │    ├─ Timeline 4 langkah  : garis vertikal + langkah-4 highlight emas
              │    ├─ Notice biaya gratis : banner wallet + footnote miring
              │    └─ FAQ accordion       : 1 kartu expand/collapse animasi
              └─ layout_bottom_sticky     (floating dock + bottom nav 5 tab)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".IsbatNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/isbat_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <!-- Judul tengah + subjudul KUA (custom center view) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="220dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp">

                <!-- ============ 1. SECTION BANNER (HERO) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Badge resmi + tanggal pembaruan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rekom_badge_official"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_verified"
                                app:tint="@color/badge_emerald_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/isbat_badge_resmi"
                                android:textColor="@color/badge_emerald_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:drawablePadding="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="@string/isbat_diperbarui"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"
                            app:drawableEndCompat="@drawable/ic_schedule"
                            app:drawableTint="@color/text_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_hero_title"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/isbat_hero_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Ringkasan alur: Sidang PA -> Buku Nikah Sah -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_rekom_info_blue"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/isbat_flow_summary"
                        android:textColor="@color/md3_info_blue_text"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_transfer"
                        app:drawableTint="@color/md3_info_blue_text" />
                </LinearLayout>

                <!-- ============ 2. KAPAN DIPERLUKAN? ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:text="@string/isbat_kapan_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_help_center"
                    app:drawableTint="@color/md3_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/isbat_kapan_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <!-- Kartu kecil poin 1 — Buku Nikah resmi (ikon deskripsi) -->
                <LinearLayout style="@style/IsbatKapanCard">

                    <ImageView
                        style="@style/IsbatKapanIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_description" />

                    <LinearLayout style="@style/IsbatKapanText">

                        <TextView
                            style="@style/IsbatKapanTitle"
                            android:text="@string/isbat_kapan_1_title" />

                        <TextView
                            style="@style/IsbatKapanDesc"
                            android:text="@string/isbat_kapan_1_desc" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kartu kecil poin 2 — Hak anak / akta kelahiran -->
                <LinearLayout style="@style/IsbatKapanCard">

                    <ImageView
                        style="@style/IsbatKapanIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_how_to_reg" />

                    <LinearLayout style="@style/IsbatKapanText">

                        <TextView
                            style="@style/IsbatKapanTitle"
                            android:text="@string/isbat_kapan_2_title" />

                        <TextView
                            style="@style/IsbatKapanDesc"
                            android:text="@string/isbat_kapan_2_desc" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kartu kecil poin 3 — Paspor & Haji/Umrah -->
                <LinearLayout style="@style/IsbatKapanCard">

                    <ImageView
                        style="@style/IsbatKapanIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mosque" />

                    <LinearLayout style="@style/IsbatKapanText">

                        <TextView
                            style="@style/IsbatKapanTitle"
                            android:text="@string/isbat_kapan_3_title" />

                        <TextView
                            style="@style/IsbatKapanDesc"
                            android:text="@string/isbat_kapan_3_desc" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 3. CHECKLIST BERKAS (4 ITEM) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_siap_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Badge jumlah berkas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_badge_teal"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/isbat_siap_badge"
                        android:textColor="@color/badge_teal_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rekom_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp">

                    <!-- Berkas 1 — N3 (badge WAJIB) -->
                    <LinearLayout
                        android:id="@+id/row_berkas_1"
                        style="@style/RekomChecklistRow">

                        <ImageView
                            android:id="@+id/iv_check_1"
                            style="@style/RekomChecklistIcon"
                            android:contentDescription="@string/syarat_check_desc"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                android:id="@+id/tv_berkas_1"
                                style="@style/RekomChecklistTitle"
                                android:text="@string/isbat_berkas_1_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/isbat_berkas_1_desc" />
                        </LinearLayout>

                        <TextView
                            style="@style/IsbatBerkasBadge"
                            android:background="@drawable/bg_badge_blue"
                            android:text="@string/isbat_badge_wajib"
                            android:textColor="@color/badge_blue_text" />
                    </LinearLayout>

                    <!-- Berkas 2 — KTP & KK (badge FOTOKOPI) -->
                    <LinearLayout
                        android:id="@+id/row_berkas_2"
                        style="@style/RekomChecklistRow">

                        <ImageView
                            android:id="@+id/iv_check_2"
                            style="@style/RekomChecklistIcon"
                            android:contentDescription="@string/syarat_check_desc"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                android:id="@+id/tv_berkas_2"
                                style="@style/RekomChecklistTitle"
                                android:text="@string/isbat_berkas_2_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/isbat_berkas_2_desc" />
                        </LinearLayout>

                        <TextView
                            style="@style/IsbatBerkasBadge"
                            android:background="@drawable/bg_badge_gray"
                            android:text="@string/isbat_badge_fotokopi"
                            android:textColor="@color/text_tertiary" />
                    </LinearLayout>

                    <!-- Berkas 3 — Bukti pendukung pernikahan -->
                    <LinearLayout
                        android:id="@+id/row_berkas_3"
                        style="@style/RekomChecklistRow">

                        <ImageView
                            android:id="@+id/iv_check_3"
                            style="@style/RekomChecklistIcon"
                            android:contentDescription="@string/syarat_check_desc"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                android:id="@+id/tv_berkas_3"
                                style="@style/RekomChecklistTitle"
                                android:text="@string/isbat_berkas_3_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/isbat_berkas_3_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Berkas 4 — Pas foto suami istri latar biru -->
                    <LinearLayout
                        android:id="@+id/row_berkas_4"
                        style="@style/RekomChecklistRow">

                        <ImageView
                            android:id="@+id/iv_check_4"
                            style="@style/RekomChecklistIcon"
                            android:contentDescription="@string/syarat_check_desc"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout style="@style/RekomChecklistText">

                            <TextView
                                android:id="@+id/tv_berkas_4"
                                style="@style/RekomChecklistTitle"
                                android:text="@string/isbat_berkas_4_title" />

                            <TextView
                                style="@style/RekomChecklistDesc"
                                android:text="@string/isbat_berkas_4_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 4. ALUR PROSES 4 LANGKAH (TIMELINE) ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/isbat_alur_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/isbat_alur_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <!-- Langkah 1 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tv_step_1"
                        style="@style/RekomStepNumber"
                        android:text="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rekom_dashed_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_1"
                        app:layout_constraintStart_toStartOf="@id/tv_step_1"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_1" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_surface_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_1"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/isbat_alur_1_title" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/isbat_alur_1_desc" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 2 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_step_2"
                        style="@style/RekomStepNumber"
                        android:text="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rekom_dashed_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_2"
                        app:layout_constraintStart_toStartOf="@id/tv_step_2"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_2" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_surface_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_2"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/isbat_alur_2_title" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/isbat_alur_2_desc" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 3 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_step_3"
                        style="@style/RekomStepNumber"
                        android:text="3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rekom_dashed_line"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_3"
                        app:layout_constraintStart_toStartOf="@id/tv_step_3"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_3" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_surface_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_3"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/isbat_alur_3_title" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/isbat_alur_3_desc" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 4 — highlight sekunder emas (penanda hasil akhir) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_step_4"
                        style="@style/RekomStepNumber"
                        android:text="4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RekomStepCard"
                        app:cardBackgroundColor="@color/md3_secondary_container"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_4"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/syarat_accent_gold"
                        app:strokeWidth="1dp">

                        <LinearLayout style="@style/RekomStepCardBody">

                            <TextView
                                style="@style/RekomStepTitle"
                                android:text="@string/isbat_alur_4_title"
                                android:textColor="@color/md3_secondary" />

                            <TextView
                                style="@style/RekomStepDesc"
                                android:text="@string/isbat_alur_4_desc"
                                android:textColor="@color/md3_secondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ============ 5. NOTICE BIAYA (GRATIS + FOOTNOTE) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_rekom_garansi_banner"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/md3_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/isbat_biaya_title"
                            android:textColor="@color/md3_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_gold"
                            android:fontFamily="sans-serif-black"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="@string/syarat_biaya_rp0"
                            android:textColor="@color/md3_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/isbat_biaya_desc"
                        android:textColor="@color/md3_secondary"
                        android:textSize="12sp" />

                    <!-- Catatan kaki miring: biaya sidang PA -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontStyle="italic"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/isbat_biaya_footnote"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- ============ 6. FAQ ACCORDION ============ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Pertanyaan Umum"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/faq_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/md3_surface_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md3_outline_variant_40"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header FAQ (klik = expand/collapse) -->
                        <LinearLayout
                            android:id="@+id/faq_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="56dp"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chat"
                                app:tint="@color/md3_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/isbat_faq_question"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/iv_faq_chevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/text_tertiary" />
                        </LinearLayout>

                        <!-- Body FAQ (awal collapsed, animasi dari Activity) -->
                        <LinearLayout
                            android:id="@+id/faq_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="44dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/isbat_faq_answer"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STICKY BOTTOM: FLOATING DOCK + BOTTOM NAV ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/md3_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <!-- Floating dock tombol aksi -->
            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_unduh_blanko"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_btn_unduh_blanko"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="14sp"
                        app:backgroundTint="@color/md3_primary_container"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_on_primary_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_konsultasi"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_btn_konsultasi"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_primary"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_chat"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_primary"
                        app:strokeColor="@color/md3_primary"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_bantuan_petugas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/isbat_bantuan_petugas"
                    android:textColor="@color/md3_primary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_help_center"
                    app:drawableTint="@color/md3_primary" />
            </LinearLayout>

            <!-- Bottom Navigation Persistent (5 tab, Layanan aktif) -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
