<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_isbat_nikah.xml
     Halaman "Isbat Nikah" (pencatatan nikah yang belum tercatat).
     Identitas editorial RIKUA: dasar krem, judul serif, aksen emas,
     rel timeline hijau solid. Toolbar hijau & chrome tetap MD3.
    ============================================================================
     Struktur:
       DrawerLayout
         └─ CoordinatorLayout (dasar krem)
              ├─ AppBarLayout + MaterialToolbar   (back | judul tengah | burger)
              ├─ NestedScrollView (paddingBottom 220dp — bebas dock)
              │    ├─ Pengenalan   : judul tegas + kaidah emas + deskripsi
              │    ├─ Kapan Diperlukan? : 3 poin datar dipisah hairline
              │    ├─ Yang Perlu Disiapkan : checklist 4 berkas interaktif
              │    ├─ Alur 4 Langkah : rel hijau solid, langkah-4 aksen emas
              │    └─ FAQ accordion  : 1 kartu expand/collapse animasi
              └─ layout_bottom_sticky     (floating dock + bottom nav 5 tab)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".IsbatNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/isbat_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_cream_light">

        <!-- =================== TOP APP BAR (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <!-- Judul tengah + subjudul KUA (custom center view) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="220dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp">

                <!-- ============ 1. PENGENALAN (editorial, tanpa hero hijau) ============ -->
                <TextView
                    style="@style/IsbatIntroTitle"
                    android:text="@string/isbat_hero_title" />

                <View style="@style/IsbatSectionRule" />

                <TextView
                    style="@style/IsbatIntroDesc"
                    android:text="@string/isbat_hero_desc" />

                <!-- ============ 2. KAPAN DIPERLUKAN? ============ -->
                <TextView
                    style="@style/IsbatSectionTitle"
                    android:layout_marginTop="32dp"
                    android:text="@string/isbat_kapan_title" />

                <View style="@style/IsbatSectionRule" />

                <TextView
                    style="@style/IsbatSectionSubtitle"
                    android:text="@string/isbat_kapan_subtitle" />

                <!-- Tiga poin datar, dipisah hairline sejajar awal teks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout style="@style/IsbatKapanCard">

                        <ImageView
                            style="@style/IsbatKapanIcon"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_description" />

                        <LinearLayout style="@style/IsbatKapanText">

                            <TextView
                                style="@style/IsbatKapanTitle"
                                android:text="@string/isbat_kapan_1_title" />

                            <TextView
                                style="@style/IsbatKapanDesc"
                                android:text="@string/isbat_kapan_1_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        style="@style/IsbatHairline"
                        android:layout_marginStart="50dp" />

                    <LinearLayout style="@style/IsbatKapanCard">

                        <ImageView
                            style="@style/IsbatKapanIcon"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_how_to_reg" />

                        <LinearLayout style="@style/IsbatKapanText">

                            <TextView
                                style="@style/IsbatKapanTitle"
                                android:text="@string/isbat_kapan_2_title" />

                            <TextView
                                style="@style/IsbatKapanDesc"
                                android:text="@string/isbat_kapan_2_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        style="@style/IsbatHairline"
                        android:layout_marginStart="50dp" />

                    <LinearLayout style="@style/IsbatKapanCard">

                        <ImageView
                            style="@style/IsbatKapanIcon"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_mosque" />

                        <LinearLayout style="@style/IsbatKapanText">

                            <TextView
                                style="@style/IsbatKapanTitle"
                                android:text="@string/isbat_kapan_3_title" />

                            <TextView
                                style="@style/IsbatKapanDesc"
                                android:text="@string/isbat_kapan_3_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 3. CHECKLIST BERKAS (4 ITEM INTERAKTIF) ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/IsbatSectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/isbat_siap_title" />

                    <!-- Indikator jumlah berkas -->
                    <TextView
                        style="@style/IsbatBerkasBadge"
                        android:background="@drawable/bg_badge_gold"
                        android:text="@string/isbat_siap_badge"
                        android:textColor="@color/gold_dark" />
                </LinearLayout>

                <View style="@style/IsbatSectionRule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <!-- Berkas 1 — N3 (badge WAJIB) -->
                    <LinearLayout
                        android:id="@+id/row_berkas_1"
                        style="@style/IsbatCheckRow">

                        <ImageView
                            android:id="@+id/iv_check_1"
                            style="@style/IsbatCheckIcon"
                            android:contentDescription="@string/syarat_check_desc"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout style="@style/IsbatCheckText">

                            <TextView
                                android:id="@+id/tv_berkas_1"
                                style="@style/IsbatCheckTitle"
                                android:text="@string/isbat_berkas_1_title" />

                            <TextView
                                style="@style/IsbatCheckDesc"
                                android:text="@string/isbat_berkas_1_desc" />
                        </LinearLayout>

                        <TextView
                            style="@style/IsbatBerkasBadge"
                            android:background="@drawable/bg_badge_gold"
                            android:text="@string/isbat_badge_wajib"
                            android:textColor="@color/gold_dark" />
                    </LinearLayout>

                    <View style="@style/IsbatHairline" />

                    <!-- Berkas 2 — KTP & KK -->
                    <LinearLayout
                        android:id="@+id/row_berkas_2"
                        style="@style/IsbatCheckRow">

                        <ImageView
                            android:id="@+id/iv_check_2"
                            style="@style/IsbatCheckIcon"
                            android:contentDescription="@string/syarat_check_desc"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout style="@style/IsbatCheckText">

                            <TextView
                                android:id="@+id/tv_berkas_2"
                                style="@style/IsbatCheckTitle"
                                android:text="@string/isbat_berkas_2_title" />

                            <TextView
                                style="@style/IsbatCheckDesc"
                                android:text="@string/isbat_berkas_2_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/IsbatHairline" />

                    <!-- Berkas 3 — Bukti pendukung pernikahan -->
                    <LinearLayout
                        android:id="@+id/row_berkas_3"
                        style="@style/IsbatCheckRow">

                        <ImageView
                            android:id="@+id/iv_check_3"
                            style="@style/IsbatCheckIcon"
                            android:contentDescription="@string/syarat_check_desc"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout style="@style/IsbatCheckText">

                            <TextView
                                android:id="@+id/tv_berkas_3"
                                style="@style/IsbatCheckTitle"
                                android:text="@string/isbat_berkas_3_title" />

                            <TextView
                                style="@style/IsbatCheckDesc"
                                android:text="@string/isbat_berkas_3_desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/IsbatHairline" />

                    <!-- Berkas 4 — Pas foto suami istri latar biru -->
                    <LinearLayout
                        android:id="@+id/row_berkas_4"
                        style="@style/IsbatCheckRow">

                        <ImageView
                            android:id="@+id/iv_check_4"
                            style="@style/IsbatCheckIcon"
                            android:contentDescription="@string/syarat_check_desc"
                            android:src="@drawable/ic_check_circle" />

                        <LinearLayout style="@style/IsbatCheckText">

                            <TextView
                                android:id="@+id/tv_berkas_4"
                                style="@style/IsbatCheckTitle"
                                android:text="@string/isbat_berkas_4_title" />

                            <TextView
                                style="@style/IsbatCheckDesc"
                                android:text="@string/isbat_berkas_4_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ 4. ALUR PROSES 4 LANGKAH (TIMELINE REL SOLID) ============ -->
                <TextView
                    style="@style/IsbatSectionTitle"
                    android:layout_marginTop="32dp"
                    android:text="@string/isbat_alur_title" />

                <View style="@style/IsbatSectionRule" />

                <TextView
                    style="@style/IsbatSectionSubtitle"
                    android:text="@string/isbat_alur_subtitle" />

                <!-- Langkah 1 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/tv_step_1"
                        style="@style/IsbatAlurNumber"
                        android:text="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/rekom_rail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_1"
                        app:layout_constraintStart_toStartOf="@id/tv_step_1"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        android:paddingBottom="22dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_1"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/IsbatAlurTitle"
                            android:text="@string/isbat_alur_1_title" />

                        <TextView
                            style="@style/IsbatAlurDesc"
                            android:text="@string/isbat_alur_1_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 2 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_step_2"
                        style="@style/IsbatAlurNumber"
                        android:text="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/rekom_rail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_2"
                        app:layout_constraintStart_toStartOf="@id/tv_step_2"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        android:paddingBottom="22dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_2"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/IsbatAlurTitle"
                            android:text="@string/isbat_alur_2_title" />

                        <TextView
                            style="@style/IsbatAlurDesc"
                            android:text="@string/isbat_alur_2_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 3 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_step_3"
                        style="@style/IsbatAlurNumber"
                        android:text="3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/rekom_rail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_step_3"
                        app:layout_constraintStart_toStartOf="@id/tv_step_3"
                        app:layout_constraintTop_toBottomOf="@id/tv_step_3" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        android:paddingBottom="22dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_3"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/IsbatAlurTitle"
                            android:text="@string/isbat_alur_3_title" />

                        <TextView
                            style="@style/IsbatAlurDesc"
                            android:text="@string/isbat_alur_3_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Langkah 4 — tahap akhir di KUA, aksen emas -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_step_4"
                        style="@style/IsbatAlurNumberGold"
                        android:text="4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_step_4"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/IsbatAlurTitle"
                            android:text="@string/isbat_alur_4_title" />

                        <TextView
                            style="@style/IsbatAlurDesc"
                            android:text="@string/isbat_alur_4_desc" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <!-- ============ 5. FAQ ACCORDION ============ -->
                <TextView
                    style="@style/IsbatSectionTitle"
                    android:layout_marginTop="32dp"
                    android:text="@string/isbat_faq_title" />

                <View style="@style/IsbatSectionRule" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/faq_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/surface_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header FAQ (klik = expand/collapse) -->
                        <LinearLayout
                            android:id="@+id/faq_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="56dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chat"
                                app:tint="@color/md3_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/isbat_faq_question"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/iv_faq_chevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/text_muted" />
                        </LinearLayout>

                        <!-- Body FAQ (awal collapsed, animasi dari Activity) -->
                        <LinearLayout
                            android:id="@+id/faq_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="46dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/isbat_faq_answer"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STICKY BOTTOM: FLOATING DOCK + BOTTOM NAV ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/md3_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <!-- Floating dock tombol aksi -->
            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_unduh_blanko"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_btn_unduh_blanko"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="14sp"
                        app:backgroundTint="@color/md3_primary_container"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_on_primary_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_konsultasi"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/isbat_btn_konsultasi"
                        android:textAllCaps="false"
                        android:textColor="@color/md3_primary"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_chat"
                        app:iconGravity="start"
                        app:iconSize="18dp"
                        app:iconTint="@color/md3_primary"
                        app:strokeColor="@color/md3_primary"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Navigation Persistent (5 tab, Layanan aktif) -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/bottom_nav_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
