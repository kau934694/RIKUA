<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
     RIKUA — activity_daftar_nikah.xml
     Halaman "Daftar Nikah: Pengantar" (Langkah 1 dari 6) MD3
     Palette: primary #005145 / #0f6b5c, container #a2f2de, secondary #795902 /
              #fdd275, surface #f7f9ff, card #ffffff, border #bec9c5 @ 40%.
     Border radius kartu & tombol: rounded-xl 12dp sesuai spesifikasi alur daftar.
    ============================================================================
     Struktur:
       DrawerLayout
         └─ CoordinatorLayout
              ├─ AppBarLayout + MaterialToolbar   (back | judul tengah | burger)
              │    └─ Bar stepper: "Langkah 1 dari 6 — Pengantar"
              │       + LinearProgressIndicator (1/6) + tombol "Simpan Draf"
              ├─ NestedScrollView (paddingBottom 220dp — bebas dock)
              │    ├─ Kartu pengantar   : sambutan alur 6 langkah
              │    ├─ Kartu checklist   : 5 dokumen (N1, KTP/KK, Akta, Foto,
              │    │                      N4/N5) + tautan Lihat Syarat Nikah
              │    │                      & Unduh Blanko Desa
              │    └─ Kotak persetujuan : checkbox wajib kebijakan privasi
              ├─ layout_bottom_sticky   : Mulai Mendaftar (gated checkbox)
              │                           + Daftar mandiri SIMKAH + bottom nav
              │                           (tab "Daftar Nikah" aktif)
              └─ NavigationView (drawer 12 menu, end)
    ============================================================================
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".DaftarNikahActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/daftar_nikah_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_background">

        <!-- =================== TOP APP BAR + STEPPER (STICKY) =================== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_primary"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md3_primary"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/services_toolbar_menu"
                app:navigationContentDescription="@string/syarat_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md3_on_primary">

                <!-- Judul tengah + subjudul KUA (custom center view) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/daf_toolbar_title"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/daf_toolbar_subtitle"
                        android:textColor="@color/md3_on_primary_container"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <!-- Bar indikator progres: label langkah + progress 1/6 + Simpan Draf -->
            <LinearLayout
                android:id="@+id/layout_stepper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/md3_primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stepper_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/daf_stepper_label"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_langkah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/daf_stepper_content_desc"
                        android:max="6"
                        android:progress="1"
                        app:indicatorColor="@color/md3_primary_container_light"
                        app:trackColor="@color/daf_progress_track"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_simpan_draf"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/daf_btn_simpan_draf"
                    android:textAllCaps="false"
                    android:textColor="@color/md3_on_primary_container"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="start"
                    app:iconSize="16dp"
                    app:iconTint="@color/md3_on_primary_container" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- =================== SCROLLABLE BODY =================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="220dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp">

                <!-- ============ 1. KARTU PENGANTAR ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/md3_surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md3_outline_variant_40"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_rekom_icon_teal_soft"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_how_to_reg"
                                app:tint="@color/md3_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/daf_intro_title"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/daf_intro_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 2. CHECKLIST DOKUMEN & INFORMASI ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/md3_surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md3_outline_variant_40"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/daf_checklist_title"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/daf_checklist_subtitle"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp" />

                        <!-- Dokumen 1: N1 -->
                        <LinearLayout style="@style/RekomChecklistRow">

                            <ImageView
                                style="@style/RekomChecklistIcon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_description" />

                            <LinearLayout style="@style/RekomChecklistText">

                                <TextView
                                    style="@style/RekomChecklistTitle"
                                    android:text="@string/daf_dok_n1_title" />

                                <TextView
                                    style="@style/RekomChecklistDesc"
                                    android:text="@string/daf_dok_n1_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="48dp"
                            android:background="@color/divider" />

                        <!-- Dokumen 2: KTP & KK -->
                        <LinearLayout style="@style/RekomChecklistRow">

                            <ImageView
                                style="@style/RekomChecklistIcon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_person_circle" />

                            <LinearLayout style="@style/RekomChecklistText">

                                <TextView
                                    style="@style/RekomChecklistTitle"
                                    android:text="@string/daf_dok_ktp_title" />

                                <TextView
                                    style="@style/RekomChecklistDesc"
                                    android:text="@string/daf_dok_ktp_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="48dp"
                            android:background="@color/divider" />

                        <!-- Dokumen 3: Akta / Ijazah -->
                        <LinearLayout style="@style/RekomChecklistRow">

                            <ImageView
                                style="@style/RekomChecklistIcon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_school" />

                            <LinearLayout style="@style/RekomChecklistText">

                                <TextView
                                    style="@style/RekomChecklistTitle"
                                    android:text="@string/daf_dok_akta_title" />

                                <TextView
                                    style="@style/RekomChecklistDesc"
                                    android:text="@string/daf_dok_akta_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="48dp"
                            android:background="@color/divider" />

                        <!-- Dokumen 4: Pas foto latar biru -->
                        <LinearLayout style="@style/RekomChecklistRow">

                            <ImageView
                                style="@style/RekomChecklistIcon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_favorite" />

                            <LinearLayout style="@style/RekomChecklistText">

                                <TextView
                                    style="@style/RekomChecklistTitle"
                                    android:text="@string/daf_dok_foto_title" />

                                <TextView
                                    style="@style/RekomChecklistDesc"
                                    android:text="@string/daf_dok_foto_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="48dp"
                            android:background="@color/divider" />

                        <!-- Dokumen 5: Persetujuan N4 / N5 -->
                        <LinearLayout style="@style/RekomChecklistRow">

                            <ImageView
                                style="@style/RekomChecklistIcon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle" />

                            <LinearLayout style="@style/RekomChecklistText">

                                <TextView
                                    style="@style/RekomChecklistTitle"
                                    android:text="@string/daf_dok_n4_title" />

                                <TextView
                                    style="@style/RekomChecklistDesc"
                                    android:text="@string/daf_dok_n4_desc" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Tautan aksi: syarat nikah & unduh blanko -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_lihat_syarat"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/daf_btn_lihat_syarat"
                                android:textAllCaps="false"
                                android:textColor="@color/md3_primary"
                                android:textSize="12sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_policy_shield"
                                app:iconGravity="start"
                                app:iconSize="16dp"
                                app:iconTint="@color/md3_primary"
                                app:strokeColor="@color/md3_primary"
                                app:strokeWidth="1.2dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_unduh_blanko"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/daf_btn_unduh_blanko"
                                android:textAllCaps="false"
                                android:textColor="@color/md3_primary"
                                android:textSize="12sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_download"
                                app:iconGravity="start"
                                app:iconSize="16dp"
                                app:iconTint="@color/md3_primary"
                                app:strokeColor="@color/md3_primary"
                                app:strokeWidth="1.2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ 3. KOTAK PERSETUJUAN KEBIJAKAN PRIVASI ============ -->
                <LinearLayout
                    android:id="@+id/layout_consent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_daf_consent_box"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_persetujuan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/daf_consent_title"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingEnd="4dp"
                        app:buttonTint="@color/md3_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/daf_consent_title"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/daf_consent_text"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STICKY BOTTOM: AKSI + BOTTOM NAV ============ -->
        <LinearLayout
            android:id="@+id/layout_bottom_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/md3_background"
            android:elevation="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <!-- Tombol utama — disabled sampai checkbox persetujuan dicentang -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mulai_mendaftar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:enabled="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/daf_btn_mulai"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:backgroundTint="@color/daf_btn_mulai_bg"
                    app:cornerRadius="12dp"
                    app:elevation="6dp"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="end"
                    app:iconSize="18dp"
                    app:iconTint="@color/daf_btn_mulai_icon"
                    app:rippleColor="@color/md3_primary_container"
                    tools:ignore="UnusedAttribute" />

                <!-- Hint saat tombol utama nonaktif -->
                <TextView
                    android:id="@+id/tv_consent_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/daf_consent_hint"
                    android:textColor="@color/daf_on_surface_variant"
                    android:textSize="11sp" />

                <!-- Aksi sekunder: portal mandiri SIMKAH Kemenag -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_simkah"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/daf_btn_simkah"
                    android:textAllCaps="false"
                    android:textColor="@color/md3_primary"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_navigation"
                    app:iconGravity="start"
                    app:iconSize="16dp"
                    app:iconTint="@color/md3_primary"
                    app:strokeColor="@color/md3_outline_variant_40"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Bottom Navigation Persisten (5 tab, Daftar Nikah aktif) -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_white"
                app:elevation="0dp"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconTint="@color/bottom_nav_color_selector"
                app:itemRippleColor="@color/primary_forest_container"
                app:itemTextColor="@color/bottom_nav_color_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/rekom_bottom_nav_menu" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- =================== NAVIGATION DRAWER (12 MENU) =================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_white"
        app:headerLayout="@layout/nav_drawer_header"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:menu="@menu/daftar_nikah_drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
