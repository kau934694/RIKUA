<?xml version="1.0" encoding="utf-8"?>
<!--
    BottomSheet sukses Langkah 6 — muncul setelah "Kirim Pendaftaran" berhasil.
    Menampilkan kode tiket (dengan aksi salin), tombol unduh bukti PDF & cek
    status, serta timeline "Tahapan Selanjutnya" (Verifikasi Petugas → NB → Akad).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomsheet_sukses"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/md3_surface_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_rekom_dashed_line" />

        <!-- Ikon sukses -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_rekom_icon_teal_soft"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/status_green" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/s6_sukses_title"
            android:textColor="@color/md3_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/s6_sukses_subtitle"
            android:textColor="@color/md3_on_surface_variant"
            android:textSize="13sp" />

        <!-- Kartu kode tiket + salin -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/md3_radio_selected_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md3_primary_container"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"
                        android:text="@string/s6_tiket_label"
                        android:textAllCaps="true"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_tiket_kode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/md3_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="RKA-2026-00123" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_salin_tiket"
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s6_btn_salin_tiket"
                    android:textAllCaps="false"
                    android:textColor="@color/md3_on_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/md3_primary_container"
                    app:icon="@drawable/ic_content_copy"
                    app:iconGravity="start"
                    app:iconSize="16dp"
                    app:iconTint="@color/md3_on_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Aksi sekunder: unduh PDF & cek status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_unduh_pdf"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/s6_btn_unduh_pdf"
                android:textAllCaps="false"
                android:textColor="@color/md3_primary"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_download"
                app:iconGravity="start"
                app:iconSize="16dp"
                app:iconTint="@color/md3_primary"
                app:strokeColor="@color/md3_outline_variant_40" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cek_status"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/s6_btn_cek_status"
                android:textAllCaps="false"
                android:textColor="@color/md3_on_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/md3_primary_container"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_search"
                app:iconGravity="start"
                app:iconSize="16dp"
                app:iconTint="@color/md3_on_primary" />
        </LinearLayout>

        <!-- Timeline tahapan selanjutnya -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/s6_next_steps_title"
            android:textColor="@color/md3_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/RekomStepNumber"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="1"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/s6_step_verifikasi"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/s6_step_verifikasi_desc"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/RekomStepNumber"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="2"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/s6_step_nb"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/s6_step_nb_desc"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/RekomStepNumber"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="3"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/s6_step_akad"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/s6_step_akad_desc"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_selesai"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/s6_btn_selesai"
            android:textAllCaps="false"
            android:textColor="@color/md3_primary"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
