<?xml version="1.0" encoding="utf-8"?>
<!--
    Header section accordion syarat (redesign MD3).
    Digunakan dua kali pada activity_syarat_nikah.xml lewat <include> dengan
    android:id berbeda (@+id/section_umum, @+id/section_khusus).
    Judul, hint jumlah ("11 berkas wajib dilengkapi"), ikon section, sub-judul,
    dan label tombol "Buka/Tutup semua" diisi dari SyaratNikahActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginTop="24dp"
    android:layout_marginEnd="18dp"
    android:orientation="vertical">

    <!-- Baris atas: ikon tile + judul/count + tombol buka/tutup semua -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_rekom_icon_teal_soft">

            <ImageView
                android:id="@+id/iv_section_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/syarat_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Untuk Semua Pendaftar" />

            <!-- "11 berkas wajib dilengkapi" — angka dari server, hint statis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_section_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_teal"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="8dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/badge_teal_text"
                    android:textSize="11sp"
                    tools:text="11" />

                <TextView
                    android:id="@+id/tv_section_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    tools:text="berkas wajib dilengkapi" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tombol toggle massal rata kanan -->
        <TextView
            android:id="@+id/btn_toggle_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="@string/syarat_buka_semua"
            android:textColor="@color/syarat_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!--
        Sub-judul kategori sekunder (label asli dari server, kolom kategori
        syarat_layanan) — tetap ditampilakan agar web & Android konsisten.
    -->
    <TextView
        android:id="@+id/tv_section_subjudul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="Syarat Umum"
        tools:visibility="visible" />
</LinearLayout>
