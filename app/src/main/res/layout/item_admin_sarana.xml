<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Rikua.FlatCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_gutter"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="@dimen/page_gutter"
    android:layout_marginBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_nama_sarana"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Masjid Besar" />

            <TextView
                android:id="@+id/tv_jenis_sarana"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_gray"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/primary_forest"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Masjid" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_desa_sarana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_location"
            tools:text="Randudongkal" />

        <TextView
            android:id="@+id/tv_alamat_sarana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="Jl. Raya Randudongkal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_sarana"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/admin_sarana_edit"
                android:textColor="@color/primary_forest"
                app:backgroundTint="@color/surface_white"
                app:cornerRadius="@dimen/radius_control"
                app:strokeColor="@color/primary_forest"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hapus_sarana"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/admin_sarana_hapus"
                android:textColor="@color/text_white"
                app:backgroundTint="@color/status_offline_text"
                app:cornerRadius="@dimen/radius_control" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
