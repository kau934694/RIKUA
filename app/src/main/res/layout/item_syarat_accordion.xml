<?xml version="1.0" encoding="utf-8"?>
<!--
    Kartu accordion satu poin syarat (tabel syarat_layanan).
    - Header selalu tampil: checkbox checklist, judul, badge wajib, chevron.
    - Body (layout_accordion_body) awalannya GONE, di-expand lewat animasi
      ValueAnimator pada SyaratNikahActivity#toggleAccordion().
    - Lebar efektif kartu = layar - 36dp (16dp padding scroll + 0 margin kartu);
      asumsi getContentWidth() di Activity, jangan diubah tanpa sinkron.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_syarat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/syarat_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: ketuk = buka/tutup body (klik panjang = tanya via WA) -->
        <LinearLayout
            android:id="@+id/layout_accordion_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <!-- Checklist persiapan: visual 24dp, target sentuh 44dp (R-03).
                 Terpisah dari expand/collapse. -->
            <ImageView
                android:id="@+id/iv_check"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/syarat_check_desc"
                android:padding="10dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/text_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_judul_syarat"
                    style="@style/SyaratItemTitle"
                    tools:text="Surat Model N1, Pengantar Nikah dari Desa" />

                <!-- Badge status: wajib (emerald) / sesuai kondisi (amber),
                     warna final di-set renderAccordion() di Activity -->
                <TextView
                    android:id="@+id/tv_badge_wajib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_emerald"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/badge_emerald_text"
                    android:textSize="10sp"
                    tools:text="WAJIB" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Body accordion (collapsed by default) -->
        <LinearLayout
            android:id="@+id/layout_accordion_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="60dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Pemisah halus header/body, rata dengan teks judul -->
            <View
                style="@style/SyaratHairline"
                android:layout_marginBottom="10dp" />

            <!-- Penjelasan rinci syarat -->
            <TextView
                android:id="@+id/tv_sub_teks"
                style="@style/SyaratItemBody"
                tools:text="Diterbitkan kantor desa/kelurahan domisili. Masa berlaku 30 hari kalender." />

            <!-- Label daftar dokumen -->
            <TextView
                android:id="@+id/tv_dokumen_label"
                style="@style/SyaratBodyLabel"
                android:layout_marginTop="10dp"
                android:text="@string/syarat_dokumen_label" />

            <!-- Chip dokumen_diminta, diisi dinamis dari array "dokumen" JSON -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipgroup_dokumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="false" />

            <!-- Catatan tambahan (peringatan amber, 5,9:1) -->
            <TextView
                android:id="@+id/tv_catatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_notice_amber"
                android:drawablePadding="6dp"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:textColor="@color/badge_amber_text"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/badge_amber_text"
                tools:text="Pastikan nama dan NIK pada N1 sama persis dengan KTP." />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
