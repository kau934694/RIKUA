<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu "Kapan Diperlukan?" dengan aksen garis vertikal tebal primary di kiri
     (analog border-l-4 primary pada desain web) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md3_surface_card" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/md3_outline_variant_40" />
        </shape>
    </item>
    <item android:width="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md3_primary" />
            <corners
                android:bottomLeftRadius="17dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="17dp"
                android:topRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
