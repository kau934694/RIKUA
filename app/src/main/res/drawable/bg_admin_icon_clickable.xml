<?xml version="1.0" encoding="utf-8"?>
<!-- Ubin aksi cepat: kartu kecil rata dengan ripple hijau agar tersentuh
     terbaca sebagai kontrol, bukan dekorasi. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/primary_forest_container">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_white" />
            <corners android:radius="@dimen/radius_card" />
            <stroke
                android:width="1dp"
                android:color="@color/surface_card_border" />
        </shape>
    </item>
</ripple>
